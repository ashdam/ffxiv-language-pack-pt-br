    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_00", "hash": "8B61FC6657494273", "target": "Guildhests são operações para pequenos grupos organizadas pela Guilda dos Aventureiros." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_01", "hash": "B05AFFBA88415412", "target": "As batalhas ocorrem em instâncias, cada uma com seu limite de tempo." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_02", "hash": "1185AFE72F573802", "target": "A recompensa pela operação depende do desempenho do seu grupo. Você recebe um bônus na primeira vez que conclui um guildhest com cada classe." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_03", "hash": "EE149A8CFE8AEF5F", "target": "Você também recebe um bônus se concluir a operação com o mínimo de nocautes." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_04", "hash": "9F8C4D6BDD56D9E8", "target": "Você desbloqueia novas operações ao subir de nível ou ao concluir outros guildhests. Algumas só ficam disponíveis depois que você fala com determinados oficiais de batalha." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_ERROR_TALK", "hash": "21ECD85496B5887A", "target": "Não foi possível iniciar “<sheet(InstanceContent,lnum2,3)>”." }
  ]
