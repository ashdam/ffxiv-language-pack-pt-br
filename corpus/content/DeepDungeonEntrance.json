  "entries": [
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_000", "hash": "D014ACE05AE92DA2", "target": "Surgiu uma grande ameaça à paz aqui na Mortalha, e fui enviado para ajudar a expulsá-la. Não permitirei que ninguém atrapalhe meu trabalho, aventureiro ou não. Agora siga caminho, por favor." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_020", "hash": "94081C319CE22A63", "target": "Por sorte, o responsável por aquele lugar maldito teve o descuido de deixar suas anotações onde pudéssemos encontrá-las. Agora talvez descubramos suas verdadeiras intenções." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_ENTER", "hash": "0E9F6E2B592A8D03", "target": "Entrar em “the Palace of the Dead”" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_RESET", "hash": "448C64F2712A52D2", "target": "Reiniciar seu progresso" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_BREAKUP", "hash": "CF823ACE0A0CC271", "target": "Dissolver seu grupo fixo" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_SCORE", "hash": "BB71ECEE909B7E1D", "target": "Ver suas pontuações" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_ABOUT", "hash": "7B524585C854C82B", "target": "Saiba mais sobre o Palace of the Dead" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MENU_TITLE", "hash": "4B0DD8A4E31B11FD", "target": "O que deseja fazer?" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MENU_FIXED", "hash": "D48DFFF1560E554B", "target": "Entrar com um grupo fixo." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MENU_MATCHING", "hash": "8F7FC8BF122E3C4E", "target": "Entrar com um grupo montado pelo sistema de pareamento." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MENU_BACK", "hash": "F8FF78A89E5500D5", "target": "Voltar." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_FIXED_Q", "hash": "9717EDA02CF9E543", "target": "Tem certeza de que deseja entrar com um grupo fixo?" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MATCHING_Q", "hash": "D82C38775795779F", "target": "Tem certeza de que deseja entrar com um grupo montado pelo sistema de pareamento?" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_050", "hash": "3B6A6705C2A6BF06", "target": "Pretende entrar nas ruínas sem companhia!? A magia de lá vai tirar suas forças, e só poderá contar com as armas de reserva etérea dos Padjal. Mesmo elas talvez não bastem sem aprimoramentos." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_SOLO", "hash": "961F8DEAF4AE1813", "target": "Tem certeza de que deseja entrar sem companhia?" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_ENTER_WHICH_Q", "hash": "6AD3098BC292E991", "target": "Por qual andar deseja entrar?" },
