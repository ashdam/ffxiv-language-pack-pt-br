    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_141", "hash": "382D15BF639A9961", "target": "Kumis está longe de ser um artigo de luxo por aqui. Sem dúvida, ela esperava que alguém de fora, como você, não soubesse disso." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_142", "hash": "2C3EE1C0B457D38D", "target": "Não podemos permitir que continue se comportando assim. Vou lhe dar uma advertência severa depois." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_143", "hash": "4052D877DCB8C0D2", "target": "Obrigado pela ajuda. Os Qestir me confiaram uma recompensa para dar a quem conseguisse me ajudar a descobrir quem estava trapaceando. Eu diria que você fez mais do que o suficiente para merecê-la!" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_150", "hash": "CF5821A029C703A8", "target": "Tem mesmo certeza disso? Você não pareceu ter muita confiança nas respostas. Pode ir verificar as barracas de novo, se a memória estiver confusa." }
  ]
}
