  "entries": [
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SEQ_00", "hash": "0B0D5E146BB9C51B", "target": "Tamachag quer investigar algumas práticas desonestas." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TODO_00", "hash": "A93BCF86A09B70B2", "target": "Visitar as barracas marcadas no mapa" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TODO_01", "hash": "36BDE2AC6B980307", "target": "Apresentar um relatório a Tamachag" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_001", "hash": "D5A8B80C9307E64F", "target": "Poderia me ajudar numa investigação?" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_002", "hash": "2340DF276D886EDC", "target": "Quem faz negócios aqui pode definir seus próprios preços. Mas ouvi falar de alguém que está abusando desse sistema e cobrando mais pelos produtos só dos clientes estrangeiros." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_004", "hash": "DA2B13FCA7AA3F5D", "target": "Se isso continuar, a reputação de Reunion será muito prejudicada. Tomei para mim a tarefa de verificar as barracas regularmente, mas suspeito que a pessoa responsável esteja escondendo seus preços extorsivos de mim." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_005", "hash": "0A8CD9BF1190554C", "target": "É por isso que preciso da sua ajuda. Por favor, investigue os comerciantes locais e anote suas mercadorias e os preços cobrados." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_006", "hash": "EE496D01F046BF4C", "target": "Marquei no seu mapa as cinco barracas que quero que visite. Volte para me dar um relatório quando terminar." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_010", "hash": "C587CCECC401BBB0", "target": "Marquei no seu mapa as cinco barracas que quero que visite. Volte para me dar um relatório quando terminar." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_BAIDUR_000_020", "hash": "D7FEF37B860A73D7", "target": "Está difícil encontrar alguma coisa? Não precisa mais procurar, porque com certeza tenho o que precisa em estoque!" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_021", "hash": "E1390AB00FDF884A", "target": "A barraca de Baidur tem uma mistura de carne, peixe e quinquilharias variadas. Todos os seus produtos são vendidos a preços baixos." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_MASGUD_000_030", "hash": "375C0C23D1873C93", "target": "Venha buscar as frutas e os legumes mais suculentos de Reunion!" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_031", "hash": "48C02B0467CAD254", "target": "A barraca de Masgud tem frutas e legumes. Todos os seus produtos são vendidos a preços altos." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_YESUI_000_040", "hash": "0DD4601AB1AF6A41", "target": "Você aí, viajante! Que tal um pouco de carne defumada? Meus preços podem ser altos, mas a satisfação é garantida." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_041", "hash": "3E312AD405A0E957", "target": "A barraca de Yesui tem carne crua, linguiças e alimentos defumados. Todos os seus produtos são vendidos a preços altos." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_BOTOKHUI_000_050", "hash": "3851FD061DAFB20A", "target": "Ora, essa aura exótica que emana... Você deve ter vindo de terras distantes! Que tal um pouco de kumis? É a bebida local mais luxuosa que tenho para oferecer." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_051", "hash": "F39C19D13CEEC333", "target": "A barraca de Botokhui tem uma variedade de bebidas alcoólicas. Todos os seus produtos são vendidos a preços muito altos." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_CHAMBUI_000_060", "hash": "4D9AE791E49E23B5", "target": "Quantos buuz <if(gnum4,a senhora,o senhor)> deseja?" },
