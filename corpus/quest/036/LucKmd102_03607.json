    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SEQ_00", "hash": "DDDCD3D40B33B28A", "target": "Alisaie pensa em tudo o que ainda precisa ser feito após a batalha." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_00", "hash": "FF17744E08146D63", "target": "Socorrer os feridos" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_01", "hash": "B9D37C7317C9792B", "target": "Falar com Lyna" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALPHINAUD_000_000", "hash": "60F182438EB6A1C7", "target": "Aguente só mais um pouco..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_URIANGER_000_005", "hash": "367B1AEA09249DE9", "target": "Deveis permanecer imóvel." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_YSHTOLA_000_010", "hash": "CB523C49CE442E18", "target": "Respire fundo para mim. Isso..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_020", "hash": "1337C1198EEC75A2", "target": "Os outros estão ajudando a tratar os feridos. Pretendo ajudar no transporte, mas, mesmo assim, simplesmente não temos gente suficiente." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_021", "hash": "F26B8C5788EF2D42", "target": "Imagino que você esteja prestes a cair de cansaço depois de tudo o que passamos, os deuses sabem que eu estou, mas seria uma ajuda enorme se pudesse cuidar de alguns pacientes." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_022", "hash": "4983B767A78D6DFD", "target": "A capitã Lyna está por aí, então você também pode perguntar se há mais alguma coisa que precise ser feita. Conversamos depois." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_025", "hash": "1C468D0DE6630F19", "target": "Aguente firme. Você vai no próximo transporte de volta ao Crystarium, eu prometo..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_030", "hash": "EB6F2FCF9022210E", "target": "Eu... Eu... \\<respiração ofegante>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SYSTEM_000_031", "hash": "09142A9F9078E5B2", "target": "Com os olhos cheios de lágrimas, o homem caído olha para você. Seus dedos se movem, como se quisesse alcançar você, mas ele não tem forças para erguer a mão." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_032", "hash": "026A21514A7A64BA", "target": "..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_033", "hash": "A430C1BBAC1DE870", "target": "O-obrigado, mas... é tarde demais." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_034", "hash": "764BD42B13DA9DF9", "target": "Um deles... me pegou. \\<tosse>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_035", "hash": "079E3225D8C46368", "target": "Se eu me transformar, por favor... Por favor, me mate, eu imploro." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_036", "hash": "DC5F40A8FD07D383", "target": "Eu... Sinto muito." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_037", "hash": "2E5A4AB19938951D", "target": "Não encoste em mim! Eu... Eu..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_038", "hash": "1627F30323FC3176", "target": "Eu a matei... Eu a matei! Ela era um deles, eu sei, mas eu... \\<soluço>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_039", "hash": "34C4519D9106702C", "target": "Talvez eu mereça isso... Mas <italic(1)>ela<italic(0)>..." }
  ]
