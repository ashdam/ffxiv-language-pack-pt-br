{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "O olhar de Minfilia mistura receio e determinação em partes iguais." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Examinar o local indicado" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Procurar Minfilia" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Procurar Thancred" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "98FAB62BF47CF33F", "target": "Sinto a presença dela, embora de leve." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "14BB5ED3DC446C07", "target": "Vamos olhar perto da muralha de cristal." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "B043A9C82585C2F3", "target": "Ela esteve aqui. No alto desta construção..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "01F8AFBF7774509E", "target": "\\<gemido>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "1F98560B1F8E0DE8", "target": "O que houve? Lembro de falar com Minfilia... e então..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "C4CB2D099EA55F50", "target": "Há algo errado?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "O que você vai dizer?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "Seu cabelo mudou." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "Seus olhos mudaram." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "1EF3A43F9F893B03", "target": "Um presente de despedida, eu acho." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "85C24CD3785579BD", "target": "Até agora, percorri o caminho que ela traçou para mim. O caminho que traçou para todas as Minfilias." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "E316E0C81CC89833", "target": "Mas ela me deu um novo caminho, uma nova vida, que posso chamar de minha." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B8900FEA1214D900", "target": "E, embora tenha partido, ainda posso senti-la... calorosa, calma e gentil." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "290EA0F2689BE40F", "target": "Sinto o coração pulsante do mundo, a Luz que cresce dentro dele." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "119683F8E011AC88", "target": "E os Guardiões da Luz. Há um aqui em Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "B664EE7BF1B57A83", "target": "Vamos voltar depressa. Os outros precisam saber." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "E0DFBC485C27CBC5", "target": "Você não acha que Thancred vai ficar bravo comigo, acha?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "O que você vai dizer?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "Era o que Minfilia queria. Tenho certeza de que ele entenderá." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "Só há um jeito de descobrir." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "142401DF331E0FC1", "target": "Também queria pensar assim, mas... \\<suspiro>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "88D4673C52E9C2B9", "target": "\\<suspiro> Sei que não há como evitar, mas..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "94BD0BE3B3AB640A", "target": "Pode ir na frente? Vou logo atrás. Prometo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "6B05FE4D20CC5770", "target": "Eu só... preciso de um momento para pensar." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "Você voltou! Estávamos começando a nos preocupar." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "<split(<string(gstr1)>, ,1)>! Graças aos deuses, você está bem." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Voltastes. Mas onde está Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "Que bom que voltou. Vejo que se saiu melhor que Thancred." }
  ]
}
