{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "O olhar de Minfilia mistura receio e determinação em partes iguais." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Examinar o local indicado" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Procurar Minfilia" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Procurar Thancred" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "9FCFFC54086025C6", "target": "(-Minfilia-)Sinto a presença dela, embora de leve." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "EE42188CC55076A8", "target": "(-Minfilia-)Vamos olhar perto da muralha de cristal." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "0E4C897F3026E735", "target": "(-Minfilia-)Ela esteve aqui. No alto desta construção..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "76150CA2E279BE7C", "target": "(-Minfilia-)\\<gemido>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "8FC0DBCA9B4FE2A5", "target": "(-Minfilia-)O que houve? Lembro de falar com Minfilia... e então..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "01F50067E3850B30", "target": "(-Minfilia-)Há algo errado?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "O que você vai dizer?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "Seu cabelo mudou." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "Seus olhos mudaram." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "B4F6FA558DC4DDCF", "target": "(-Minfilia-)Um presente de despedida, eu acho." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "043AD5AB6C7A875E", "target": "(-Minfilia-)Até agora, percorri o caminho que ela traçou para mim. O caminho que traçou para todas as Minfilias." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "0B4C6292AC9CA40A", "target": "(-Minfilia-)Mas ela me deu um novo caminho, uma nova vida, que posso chamar de minha." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B58F0DF82A0A40C3", "target": "(-Minfilia-)E, embora tenha partido, ainda posso senti-la... calorosa, calma e gentil." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "85EE556D50812892", "target": "(-Minfilia-)Sinto o coração pulsante do mundo, a Luz que cresce dentro dele." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "C7014C709D3D7006", "target": "(-Minfilia-)E os Guardiões da Luz. Há um aqui em Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "90F6953FA44289D9", "target": "(-Minfilia-)Vamos voltar depressa. Os outros precisam saber." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "B0D535A6E5FDEE8B", "target": "(-Minfilia-)Você não acha que Thancred vai ficar bravo comigo, acha?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "O que você vai dizer?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "Era o que Minfilia queria. Tenho certeza de que ele entenderá." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "Só há um jeito de descobrir." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "01EAF4FF1E79E788", "target": "(-Minfilia-)Também queria pensar assim, mas... \\<suspiro>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "D2D1EDFF12C6C31C", "target": "(-Minfilia-)\\<suspiro> Sei que não há como evitar, mas..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "ABB7F49F2651F470", "target": "(-Minfilia-)Pode ir na frente? Vou logo atrás. Prometo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "E858807928D8C629", "target": "(-Minfilia-)Eu só... preciso de um momento para pensar." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "Você voltou! Estávamos começando a nos preocupar." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "<split(<string(gstr1)>, ,1)>! Graças aos deuses, você está bem." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Voltastes. Mas onde está Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "Que bom que voltou. Vejo que se saiu melhor que Thancred." }
  ]
}
