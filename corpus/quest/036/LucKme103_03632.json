{
  "conversation": "quest/036/LucKme103_03632",
  "gameVersion": "2026.10.06.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_SEQ_00", "hash": "9B70445F02670201", "target": "Thancred tem uma tarefa para você." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_00", "hash": "D6DAEDDA6CC657E4", "target": "Procurar civis dominados nos Derelicts" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_01", "hash": "B363C39BF2960A69", "target": "Aplicar pó dos sonhos em Thoarich" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_02", "hash": "407BE3845300622F", "target": "Procurar civis dominados no Understory" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_03", "hash": "39CC28C79AE2538C", "target": "Aplicar pó dos sonhos na jovem amável" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_04", "hash": "125133850B54D1C1", "target": "Procurar civis dominados no Canopy" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_05", "hash": "50DC2E0C18C33DF8", "target": "Aplicar pó dos sonhos no cidadão livre" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_06", "hash": "F4166207A1C36242", "target": "Falar com Ryne" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_ALPHINAUD_000_000", "hash": "A37D0212131CBF6B", "target": "Obrigado novamente, <split(<string(gstr1)>, ,1)>. Vamos procurar os feridos e ajudar como pudermos." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_ALISAIE_000_005", "hash": "BB3A42C58E4DEB2E", "target": "Alguns conseguiram escapar do controle mental, mas acabaram presos no caos. Vamos garantir que recebam tratamento também." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_010", "hash": "AF4899B06409F4B3", "target": "Está tudo bem. Agora você está em segurança." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_PATIENT03631_000_015", "hash": "DBB2994E752C7B01", "target": "\\<gemido> O que... o que houve?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_URIANGER_000_020", "hash": "8DA779093644A9F9", "target": "Sem liderança, os soldados perderam a vontade de lutar. Não representam ameaça para nós." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_YSHTOLA_000_025", "hash": "003BC37C236A1622", "target": "Então era assim que os cidadãos viviam, o sonho de Eulmore. Eles terão um despertar bem desagradável." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_030", "hash": "B6913CC2A2CD8DCA", "target": "Então, aqui está um pouco de pó dos sonhos." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_031", "hash": "525B123275DAFDC0", "target": "Estamos aplicando nos dominados para mantê-los calmos até receberem o devido atendimento. Agradeceria se pudesse ajudar." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_032", "hash": "9F2468293B2DA0DA", "target": "Os afetados estão espalhados por toda a cidade. Sugiro começar pelos Derelicts e subir." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_033", "hash": "CF5B8F0F556E5C46", "target": "Quando terminar, avise Ryne." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_040", "hash": "BA5C2ADAC1AE946F", "target": "Ó, Lorde Vauthry... O senhor é... meu meol de cada dia..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_050", "hash": "A97BCC7A4B1BFFD5", "target": "\\<ronco> \\<ronco>" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_060", "hash": "13AB24445EA80561", "target": "Mmmmmm... meol... \\<sorvida>" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_065", "hash": "67A6311C3CAAB3D3", "target": "\\<arquejo> Conheço você!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_LADY03287_000_070", "hash": "DB6E0A61E5F8D5E3", "target": "Ahhh... dói... Por favor, Lorde Vauthry... tire a dor..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_071", "hash": "BCD105BB6293E65D", "target": "Você é a alma bondosa que me salvou de cair para a morte!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_072", "hash": "1C0CC6E2819F9C8C", "target": "M-minha senhora se machucou! Por favor, ajude-a, eu imploro!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_075", "hash": "8DF30FB50C50CC6E", "target": "Por favor, não pode fazer nada por ela?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_080", "hash": "95204AF6BFD569E8", "target": "O-o que é isso?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_081", "hash": "D4E21E47868B569A", "target": "Ela está... dormindo. Diz que é um remédio para ajudá-la a descansar enquanto espera tratamento?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_082", "hash": "7143DD1B292C77AC", "target": "Ah, agradeço muito! Quando começou a agir de modo estranho, não sabia o que fazer..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_LADY03287_000_090", "hash": "C2039929498604EB", "target": "Zzzzzz..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_095", "hash": "F7B374A00818A578", "target": "Não vou sair do lado da minha senhora." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_100", "hash": "FA14E22227A1D665", "target": "Preciso deter... invasores... Profanando... nosso paraíso..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_110", "hash": "07442D5EBAD4439C", "target": "\\<bufada> Para onde voou... meu doce canário...?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_120", "hash": "346D90BC5D160DC7", "target": "Por favor, não me deixe... Zzzzzz..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_130", "hash": "BC462AB698AE58C0", "target": "Ah, aí está você, <split(<string(gstr1)>, ,1)>." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_131", "hash": "F3E6A72CE0564401", "target": "Acabei de ajudar este homem. Agora, o próximo..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_132", "hash": "012226205AFE6630", "target": "Há mais nos Derelicts e lá embaixo? São tantos..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_133", "hash": "745D6916F82DB913", "target": "Mas Minfilia me confiou este poder. Não vou descansar até ajudar todos." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_Q1_000_000", "hash": "2AB99389C8DFB4A2", "target": "O que você vai dizer?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_A1_000_001", "hash": "C807D127E8BF80F2", "target": "Posso trazer os dominados até você." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_A1_000_002", "hash": "2A2591130B7B1A1E", "target": "Vou cuidar dos feridos." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_134", "hash": "12883BBC2D6832DB", "target": "Ah, isso certamente facilitaria meu trabalho." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_135", "hash": "B0CD951EDDFA8C5A", "target": "Obrigada, <split(<string(gstr1)>, ,1)>. Vou fazer o possível para acompanhar." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_136", "hash": "37F4BD92E658FCC9", "target": "Tenho certeza de que Alphinaud e Alisaie agradeceriam a ajuda." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_137", "hash": "B0C577E360F6C81E", "target": "E, se encontrar outros civis dominados, por favor, mande trazê-los até mim." }
  ]
}
