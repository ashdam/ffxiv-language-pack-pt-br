{
  "conversation": "quest/049/KinGmd119_04930",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SEQ_00", "hash": "C6DFBBF18B0C7D1B", "target": "Sphene deseja levar você de volta aos arredores." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_00", "hash": "F47D7A6FB6A61DA2", "target": "Falar com Wuk Lamat" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_01", "hash": "C1C77551FAF864CF", "target": "Falar com Wuk Lamat novamente" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_02", "hash": "589DF18F5BA6FA8C", "target": "Falar com os moradores dos arredores" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_03", "hash": "FC91035468A1EFC4", "target": "Esperar no local indicado" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_04", "hash": "73669EBE32765892", "target": "Examinar o local indicado" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_05", "hash": "21B33A26C2575F0A", "target": "Falar com Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_06", "hash": "DD76829BAB93E9AB", "target": "Falar com Erenville novamente" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_07", "hash": "1E89DA1553A4114B", "target": "Falar com Erenville novamente" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_08", "hash": "A875AD082474E08A", "target": "Falar com Erenville no esconderijo de Earthen Sky" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_001", "hash": "60247F35B647A270", "target": "Zoraal Ja, seu desgraçado..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_010", "hash": "B1AE6A10D4ADFAE7", "target": "Que tal voltarmos aos arredores? Imagino que seus amigos também já tenham retornado." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_011", "hash": "26C36AE2671C0FBA", "target": "Obrigada de novo por cuidarem dos monstros. Venham nos visitar quando quiserem." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_015", "hash": "0E784544CCD3109F", "target": "...Está ouvindo isso?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_020", "hash": "6836547F3A623E26", "target": "Há tanto de Alexandria que eu adoraria mostrar a vocês!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_025", "hash": "466E22E701C32C09", "target": "Como todos, tenho a maior admiração e respeito pela rainha Sphene. Mas dá um pouco de vergonha dizer essas coisas pessoalmente..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_030", "hash": "0181ED5EF2D7553F", "target": "O que está acontecendo? Como Pepoane pôde esquecer Namikka de repente?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_031", "hash": "4693B30925982B41", "target": "É como se nunca tivesse conhecido ela..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_032", "hash": "48E62BEE6CA790AD", "target": "Será que aconteceu o mesmo com outras pessoas?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_033", "hash": "2847A2BA87D9DB82", "target": "Só há um jeito de descobrir. Vamos perguntar sobre Namikka por aqui. Depois podemos nos reunir na eterita." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_034", "hash": "1F7F3F4225AA2358", "target": "Isso é muito perturbador..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_035", "hash": "3E4012242764B40D", "target": "Pelo que pude perceber, Pepoane realmente não tinha nenhuma lembrança de Namikka." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_036", "hash": "11C49DE405204489", "target": "Vamos ver como é com as outras pessoas." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_037", "hash": "0DDE4650547EAC8F", "target": "Nunca vi nem ouvi falar de nada parecido." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_040", "hash": "119A8BC6F5C1FAFB", "target": "Uma senhora chamada Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_041", "hash": "65356C4EE4ECF938", "target": "Receio que não conheço essa pessoa. Desculpe não poder ajudar." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_045", "hash": "1C7C6C7FBD1AB388", "target": "Sinto muito. Talvez outra pessoa conheça essa Namikka." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_050", "hash": "D659BD44989C52E2", "target": "Como é? Se conheço uma Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_051", "hash": "84189B80272711AD", "target": "Nunca conheci ninguém com esse nome, e já faz tempo que trabalho nos arredores. Se ela tivesse passado por aqui, eu lembraria." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_055", "hash": "5744D95B776615C7", "target": "Provavelmente essa Namikka está lá na nuvem..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_060", "hash": "ED4574503F316AA3", "target": "Hmmm... Lembro de cuidar de alguém até pouco tempo. E você diz que era uma mulher chamada Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_061", "hash": "D20F6CC217EBBB1F", "target": "Não posso afirmar que era ela, mas não me preocuparia. Tenho certeza de que só foi levada à nuvem." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_065", "hash": "88F8EB07D75C8AE0", "target": "Não é comum, mas acontece de vez em quando." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_070", "hash": "76A618F7B6D34EA6", "target": "Então foi igual com todos." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_071", "hash": "EB407F43929A360D", "target": "Ninguém lembra de Namikka. É como se a memória dela tivesse sido apagada das suas mentes." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_072", "hash": "24F4B3B42DC2FE00", "target": "Embora seja possível fazer isso com magia, alterar as memórias de tantos de uma só vez seria uma tarefa enorme. Também teríamos sentido uma onda de éter correspondente, e não senti nada naquele momento." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_073", "hash": "93DE1E0CB899C4B8", "target": "Nem eu. Mas notei outra coisa: logo antes de Pepoane aparentemente esquecer, uma luz no dispositivo da cabeça dele começou a piscar." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_074", "hash": "BF8911447E506DD5", "target": "Será que há uma ligação? Alguém também mencionou “células de alma”." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_075", "hash": "286490A7A2CF40F8", "target": "Mas a quem podemos perguntar? Se continuarmos fazendo perguntas assim, imagino que só causaremos confusão." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_076", "hash": "CA4023D9C89DFDCE", "target": "É... Se não podemos resolver logo o mistério de Namikka, talvez possamos procurar Cahciua?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_077", "hash": "CDC6F4C263E3C530", "target": "Sphene disse para tentar nos Thunderyards." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_078", "hash": "99CD3E096930CB24", "target": "Deve ser nesta direção." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_079", "hash": "E1E3976D0D83D5C9", "target": "\\<espanto> Impossível!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_080", "hash": "F36CCC3F4934D032", "target": "Hum?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_081", "hash": "91F960CBF9EF453A", "target": "Outro tipo de soldado mecânico!? Parece perigoso! É melhor destruir!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_082", "hash": "E430ACF1C40362FC", "target": "Uaaah!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_083", "hash": "2B9C07FBFD76A08B", "target": "Vamos atrás?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_084", "hash": "807CB71DF75A7628", "target": "Acho que entendeu nossas palavras. Talvez valha a pena fazer algumas perguntas." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_085", "hash": "29C3793E1DAB276A", "target": "...Erenville? Tudo bem? Parece que viu um fantasma." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_086", "hash": "9254BFC9B39F7FEB", "target": "N-Não é nada. Estou bem." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_087", "hash": "F70D12522849D922", "target": "Bem, foi na direção em que estamos indo, então vamos tentar encontrar." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_090", "hash": "337F441CBA65184F", "target": "Só tem pássaros por aqui." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_095", "hash": "8E72C156D1350BE7", "target": "É mais rápido do que parece." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_100", "hash": "FDCC669D3E2E4AA5", "target": "Nenhum sinal por aqui." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_105", "hash": "37134E88B7AA3560", "target": "Não estou vendo..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_108", "hash": "53365A73CA27F6E4", "target": "Aquela voz... Será que...?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_110", "hash": "E95002F06602F15E", "target": "Você encontrou!?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_111", "hash": "78EC4283682595E7", "target": "A nordeste? Então deve estar indo para as minas." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_112", "hash": "E567824C0329C13B", "target": "Vamos, então!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_113", "hash": "3D0AEF8B53B2BAC2", "target": "Pode muito bem ser uma armadilha, então vamos com calma." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_115", "hash": "7492E4B160153F58", "target": "Então entrou aqui?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_120", "hash": "86DBB98F36DBA13D", "target": "Acho que podemos presumir que entrou nas minas." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_125", "hash": "DFF9135B2F425999", "target": "Uma antiga mina de carvão? Parece abandonada há muito tempo, como tantos outros lugares." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_130", "hash": "4686892213FFDB2D", "target": "As pedras naquelas caixas... Será turquesa?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_140", "hash": "99F2669B78550D50", "target": "Ouvi vozes baixas vindo de dentro." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_141", "hash": "F72778215E3A0080", "target": "Então não está sozinho. Mas vamos entrar mesmo assim, claro?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_142", "hash": "A410B36355B6E105", "target": "Pode ser uma armadilha. Preparem-se pra lutar, pessoal!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_145", "hash": "3B821132C812449A", "target": "Este túnel não acaba mais..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_150", "hash": "3704AF0C26400FBC", "target": "Não estou preocupada. Já tivemos que improvisar inúmeras vezes, afinal." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_155", "hash": "40ACB8CF0759F299", "target": "Um dispositivo feito de electrope. Parece ser o único aqui." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_160", "hash": "011C1B07F4394021", "target": "Parece que ninguém trabalha nestes túneis há bastante tempo..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_170", "hash": "8E3E69D9830F6B90", "target": "Consigo ouvir. Várias pessoas adiante." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_171", "hash": "AD96336CB410EEAB", "target": "Hum. Não consigo entender a conversa com o eco." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_172", "hash": "8DA5B2DE08135E68", "target": "Vamos continuar. Fiquem atentos." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_180", "hash": "F57FED4BA2FF7A62", "target": "Não posso dizer que entendo o que está acontecendo, mas pelo menos Cahciua está a salvo." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_185", "hash": "5FA3713415D309FD", "target": "A mãe de Erenville é uma máquina flutuante. Certo, faz tanto sentido quanto todo o resto até agora." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_190", "hash": "E7527FFF649B7C11", "target": "A esta altura, duvido que qualquer coisa ainda consiga me surpreender." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_195", "hash": "D2DB65B3447BBBC7", "target": "Os alaganos tinham máquinas controladas à distância. Será que ela usa algo parecido para falar conosco?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GEODE_000_200", "hash": "C2DA09F5AD6029AE", "target": "Com ela, sempre sobra emoção... Desculpem por apontarmos as armas para vocês." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_NOSTALGIA_000_205", "hash": "72AF1E28F1A52E7B", "target": "Se serve de consolo, tudo isso também é bastante confuso para nós." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WAYAKKWE_000_210", "hash": "4C4DE322FF01C9AF", "target": "Ah, hum... olá." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_215", "hash": "910D3B31D56D999C", "target": "Vamos, vamos, fiquem à vontade!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_220", "hash": "268B46596B7FEAD2", "target": "Pelo que posso perceber, é mesmo minha mãe. Conheço poucas pessoas tão cheias de vida..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_221", "hash": "E5B70BE407BFEA5C", "target": "Mas, quanto ao que aconteceu, precisamos perguntar a ela..." }
  ]
}
