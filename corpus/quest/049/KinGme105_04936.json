{
  "conversation": "quest/049/KinGme105_04936",
  "gameVersion": "2026.10.06.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SEQ_00", "hash": "4DC3BA8430957E22", "target": "Depois de conhecer o distrito a seu contento, Wuk Lamat está pronta para ir ao ponto de encontro." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_00", "hash": "72979CDA504F7460", "target": "Falar com Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_01", "hash": "B00AB75591B48E6E", "target": "Examinar o local indicado" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_02", "hash": "AD8C72E52E2846C2", "target": "Falar com a criança Hoobigo de escamas azuis e segui-la na companhia de Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_03", "hash": "E7D41C4ECCC7F9C4", "target": "Seguir a criança Hoobigo de escamas azuis na companhia de Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_04", "hash": "B43ED6F13F612BED", "target": "Falar com Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_001", "hash": "D711C988090B6935", "target": "Então, temos que ir a um lugar chamado True Vue, no setor leste. Este transportador deve levar a gente até lá." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_002", "hash": "A9FA79D02201DDE8", "target": "Sabe, depois que você se acostuma, até que é divertido. Vamos, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_010", "hash": "1F7F405B0C0EBC71", "target": "Será que é o lugar certo?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_011", "hash": "85D269696ABC8AC2", "target": "Mas não vejo os outros..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_012", "hash": "AAA003FCB7D5E19E", "target": "Bem, em vez de sentar e esperar, podemos explorar um pouco mais." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_013", "hash": "A0A30846D7995928", "target": "Hã? <split(<string(gstr1)>, ,1)>, olhe ali!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_014", "hash": "52E04AAF6006B966", "target": "Uma criança Mamool Ja... O que faz aqui?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_015", "hash": "84BA33B64848BB50", "target": "Você também notou, não é? A semelhança com Zoraal Ja." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_016", "hash": "0FA2D311187B1121", "target": "As escamas azuis de um Boonewa com os traços de um Hoobigo..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_017", "hash": "81AF68C16847AA38", "target": "Isso não pode ser coincidência." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_018", "hash": "C58674BB0A83DC7F", "target": "Seja como for, não podemos deixar uma criança tão pequena sozinha." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_019", "hash": "3C58AA780476FCD6", "target": "Vamos atrás dela!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_019", "hash": "A70D0540CDAD2426", "target": "Acho que correu por aqui..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_020", "hash": "31ACC571C6BBE5EE", "target": "Então isto é True Vue. Não sei bem o que estou vendo, mas parece animado!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_021", "hash": "BBF2849FD3A94DB0", "target": "Aquele prédio é praticamente o único sem luz. Acho que está fechado no momento?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_022", "hash": "8231A914FCF1CC3F", "target": "Uaaah!?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_023", "hash": "9F715B1CC1D7F68A", "target": "E-Eu não tinha visto você aí..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_024", "hash": "337FC3CF4F058A4A", "target": "Escute, não queremos machucar você. Só queremos conversar." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_025", "hash": "43306135F879B303", "target": "É meio estranho, não acha? Foge quando chegamos perto, só para reaparecer de repente..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_026", "hash": "8F0353734599DD2B", "target": "Será que quer nos levar a algum lugar?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_027", "hash": "BE3440E2014F888F", "target": "É isso? Quer que a gente siga você?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_028", "hash": "E448F9002EC15043", "target": "Então é! Certo, mostre o caminho!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_030", "hash": "9EFDD5B841DDBBF9", "target": "Vamos ver aonde nos leva." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_040", "hash": "4421C94215A55747", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_000_044", "hash": "BA70C4EDA64BBCF2", "target": "Seguir a criança Hoobigo de escamas azuis?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q1_000_000", "hash": "EB588CC646DD0F4F", "target": "O que você vai fazer?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_001", "hash": "1BC242E3E91C1E1B", "target": "Conversar." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_002", "hash": "04FC3A36E379E073", "target": "Separar-se." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_003", "hash": "5E7465CC09960E9E", "target": "Nada." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_044", "hash": "73D51D10CE27A8AA", "target": "Vamos tentar não perder de vista desta vez!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q2_000_000", "hash": "1EDB80CAFE8E4487", "target": "Tem certeza de que deseja se separar de Wuk Lamat?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_045", "hash": "87C514F8313966AC", "target": "Hum? A comida alexandrina não caiu bem? Certo, vou avisar ao pequeno que precisa de um tempo. Vamos esperar você onde começamos." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_110_045", "hash": "0F9849D4E52095B8", "target": "Wuk Lamat ainda não chegou. Certifique-se de que esteja ao seu lado antes de tentar continuar." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_120_045", "hash": "8962B0DC3B12B922", "target": "Droga, perdemos ele! Melhor voltar pra onde começamos..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_130_045", "hash": "E11D89D0D3763EF7", "target": "Fale com a criança Hoobigo de escamas azuis na zona de lazer para tentar de novo." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_045", "hash": "9F8BFF5E64AA92FF", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_050", "hash": "62865C83A6DDB1E9", "target": "Era aqui que você queria nos trazer?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_051", "hash": "45E7BA8F57CB89A9", "target": "Que lugar é este? Se é para relaxar aqui, comigo não está funcionando..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_052", "hash": "95D67D1BFC2D7202", "target": "Ei, como você se chama?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_053", "hash": "A51E18DF1B71ED9E", "target": "Então você ainda não quer conversar..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_054", "hash": "8B614746931724F2", "target": "Ele só fala quando se sente completamente à vontade com você." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_055", "hash": "5A4E1514E39ABFF1", "target": "Você o conhece?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_056", "hash": "84FF9A4782AA01A7", "target": "De certa forma. Mas isso não importa agora. Que tal algo para molhar a garganta?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_057", "hash": "49EA5B2174C5E2E1", "target": "Vocês são uma graça, então é por conta da casa. Recomendo nossa especialidade, Sua Majestade. Vou preparar uma sem álcool para o menino também." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_058", "hash": "EE3469931A36E8DD", "target": "Ah, obrigada, mas não. Temos que encontrar uma amiga chamada Cahciua." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_059", "hash": "FB9ACC2479267D8C", "target": "Mas encontramos o menino no caminho, e ele nos trouxe aqui." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_060", "hash": "6D5904336642183A", "target": "Ahhh, então estão com Cahciua." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_061", "hash": "EF39C4E1FA9D3D56", "target": "Nesse caso, conversem com o grandalhão Tassos ali. Ele mostrará um lugar divertido." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_062", "hash": "7476EE0F8CF2E073", "target": "E ele?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_063", "hash": "400556D1123C7B3E", "target": "Acho que não está com vontade de conversar, então pode cuidar do bar comigo." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_064", "hash": "85F8A93086D18F3B", "target": "Isso ficou estranho, mas você não acha que estamos entrando numa armadilha, acha?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_065", "hash": "7E34942071AADC94", "target": "Que coisa mais suspeita, de todo jeito..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_070", "hash": "EAF01758269C6B7F", "target": "Se mudar de ideia sobre aquela bebida, é só avisar." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_075", "hash": "B50D8F571265E752", "target": "..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TASSOS_000_080", "hash": "273A4B42A415C42B", "target": "Você parece com pressa, mas e sua amiga ali?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_090", "hash": "B5449B099F1CF6FD", "target": "O que será esse “lugar divertido”? Cahciua está lá?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_091", "hash": "2D98A6AB4FD96705", "target": "Bem, acho que só tem um jeito de descobrir..." }
  ]
}
