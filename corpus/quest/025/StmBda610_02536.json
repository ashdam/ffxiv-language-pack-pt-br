{
  "conversation": "quest/025/StmBda610_02536",
  "gameVersion": "2026.10.06.0000.0000",
  "entries": [
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_SEQ_00", "hash": "0FE358E431BDA3DB", "target": "Alisaie está pronta para deixar Ala Ghiri quando você quiser." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_00", "hash": "21AC4C03C90C8ACA", "target": "Patrulhar Wightrock em busca de forças imperiais" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_01", "hash": "2F23A23CD9F37831", "target": "Encontrar Alisaie" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_001", "hash": "CF7EA01691BA6612", "target": "Temos uma área grande para cobrir, então vamos nos separar. Se encontrar soldados imperiais, sabe o que fazer." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_002", "hash": "8C968B641F5B3D71", "target": "Ah, avisei o pelotão de Arenvald. Já estão vasculhando outras áreas próximas, então teremos aliados se encontrarmos algo além das nossas forças." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_010", "hash": "6B43B53B4733E8B1", "target": "Forças inimigas avistadas!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_015", "hash": "98555A158F391AC8", "target": "Ataquem! Ataquem!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_020", "hash": "6B0E4DC19C0A5BE3", "target": "Ah, só um momento, <split(<string(gstr1)>, ,1)>." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_200_020", "hash": "DA3B107160666710", "target": "Repita, por favor.<br>...Hmm. Não, mantenham distância por enquanto." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_100_020", "hash": "94F7C227E9939270", "target": "...Entendido. Me mantenha informada de qualquer novidade." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_021", "hash": "4EB345257AEA5824", "target": "Era Arenvald. A dupla que nos espionava nos Fringes nos seguiu até aqui..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_022", "hash": "EA2EBCF4E93D3714", "target": "E você, <split(<string(gstr1)>, ,1)>? Algum problema?" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_023", "hash": "8F64A4763FFFFCA4", "target": "...E eu que achei que teríamos um pouco de paz. Ainda bem que cuidou deles." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_024", "hash": "956DE7AF29B35555", "target": "Espero que o ataque a Specula Imperatoris esteja indo bem..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_025", "hash": "7C539CE7E491E78B", "target": "Pelos Doze, você viu!? A torre principal acabou de desabar!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_026", "hash": "910CC5B0C09E5B1E", "target": "Você também ouviu, não? Deve ter sido o canhão de Castrum Abania. Mas era uma instalação imperial, e suas tropas ainda estavam..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_027", "hash": "FD44AC87437BDC08", "target": "Droga, ninguém responde! Não sei se estão interferindo na linkshell ou..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_028", "hash": "F34095D19F3BBB23", "target": "Precisamos ir agora! Eles precisam de ajuda!" }
  ]
}
