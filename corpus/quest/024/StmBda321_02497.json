    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_06", "hash": "034334E5A82FDF9A", "target": "Procurar Yugiri" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_07", "hash": "E3A5117690BC08CA", "target": "Voltar com Yugiri à House of the Fierce" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_000", "hash": "6C81DE0CDFAD7B95", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_005", "hash": "8CB3B21355879502", "target": "Só... só mais alguns anos... \\<ronco>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_010", "hash": "0585C23C598F1190", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_011", "hash": "C1D9C565CCC02AAC", "target": "Perdoe-me, <split(<string(gstr1)>, ,1)>. Eu estava... perdida em pensamentos." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_012", "hash": "04DAAEC69A5B5A05", "target": "Talvez tenham razão. Talvez sejamos tolos por insistir que se rebelem outra vez. Mas acredito, eu <italic(1)>preciso<italic(0)> acreditar, que no fundo de seus corações eles... eles ainda..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_013", "hash": "FEAA2F527923383C", "target": "...Agora não é hora. Precisamos terminar o que começamos." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_014", "hash": "82061C235F0ECEF4", "target": "Tenho um remédio poderoso que confunde a mente e as lembranças. Precisamos administrá-lo aos soldados antes que acordem." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_015", "hash": "4F6110F5F1C6335D", "target": "O remédio deixará os soldados confusos, sem lembrar direito dos acontecimentos recentes. Vão suspeitar que dormiram em serviço e evitarão falar disso com os outros." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_016", "hash": "9D067FE2611F8112", "target": "É só uma medida temporária, mas não podemos matá-los, pelo bem dos aldeões. Cuide dos dois últimos que adormeci. Cuidarei dos outros." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_020", "hash": "C897CC5AF618E348", "target": "\\<ronco> ...<if(gnum4,Mãe,Pai)>, é você...?" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_030", "hash": "3B6D251E40178DBB", "target": "Eu... eu quero ir para casa... \\<ronco>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_040", "hash": "7A03CA8D509B2DF5", "target": "Venha, venha! Precisamos avisar os outros sobre a aeronave, ou ouvir o que sabem dela!" }
  ]
}
