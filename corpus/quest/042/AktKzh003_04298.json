{
  "conversation": "quest/042/AktKzh003_04298",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_SEQ_00", "hash": "496E6C6F841F82CC", "target": "<colortype(508)><edgecolortype(509)>\uE0BE Quest Sync<edgecolortype(0)><colortype(0)><br>O colega do calm observer está fora há tempo demais." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_00", "hash": "69339135B9F7B01F", "target": "Falar com o Thalassai observer" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_01", "hash": "6DF6B5CDB3A64E3E", "target": "Alimentar as Zephyros 72s" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_02", "hash": "D224459EEB652FB6", "target": "Entregar as Zephyros 72s ao Thalassai observer" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_03", "hash": "D7760AB601EFB269", "target": "Falar com o Thalassai observer" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_000", "hash": "3DEBAC09B7C261E2", "target": "Posso pedir um favor? Um colega meu de Thalassai está atrasado para apresentar seu relatório, e preciso que alguém lhe dê um lembrete gentil." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_001", "hash": "4A21DACAE9F47D96", "target": "Ele está em Rumination's Ramble, observando formas de vida recém-saídas dos ovos de uma de nossas criações. Mas tenho medo de distorcer os dados se eu aparecer e assustá-las." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_002", "hash": "86392E3DDEC8E887", "target": "Um familiar como você, porém, deve causar muito menos perturbação. Você teria essa gentileza...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_003", "hash": "41EAA6896D07D9DE", "target": "Você encontra meu colega em Rumination's Ramble." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_100_001", "hash": "F9EB9CAC8698E448", "target": "\\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_100_002", "hash": "88056B9D7CAED8AD", "target": "\\<farfalho> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_100_003", "hash": "94A5200B91E37971", "target": "\\<farfalho> \\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_100_004", "hash": "C725F749203CEBFB", "target": "\\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_004", "hash": "2A9F571C8688B8C8", "target": "Um familiar? Posso ajudar em alguma coisa?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_005", "hash": "3EA79F3B49CCE862", "target": "Ah, já está na hora de voltar? Fiquei tão encantado vendo os pequeninos brincarem que perdi a noção do tempo." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_006", "hash": "5432E9271E361FAB", "target": "Venham, venham todos! Precisamos mesmo ir!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_007", "hash": "CD43FD10446E25CE", "target": "(-Zephyros 72-)\\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_008", "hash": "B1C8FC143772BF55", "target": "Ainda querem brincar, é? Acho que vamos ter que apelar para as suas barriguinhas, então!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_009", "hash": "E23D52B11BCA3032", "target": "Quer tentar alimentá-los?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_010", "hash": "4E91437CDF273E3D", "target": "Eles ficam muito mais dóceis depois de comer alguns destes petiscos. E são tão adoráveis quando mordiscam!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_011", "hash": "66DC8AE699863255", "target": "Vá em frente, dê alguns petiscos a eles." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_013", "hash": "CCE92DA2253EFD15", "target": "\\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_014", "hash": "2526E3C552FBC6D1", "target": "\\<farfalho> \\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_015", "hash": "B0A406E62A0AA480", "target": "\\<farfalho> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_016", "hash": "933FE6FF9EB8E90F", "target": "\\<farfalho> \\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_017", "hash": "89A9CAE82C770FA3", "target": "\\<farfalho> ..." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_018", "hash": "906DB950652B7D8F", "target": "\\<farfalho> \\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_019", "hash": "165A00AEB4C47038", "target": "\\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_020", "hash": "CAFD7EAD20738C76", "target": "\\<farfalho> \\<farfalho>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_021", "hash": "2511DF47594EFDFD", "target": "Não é divertido ver como eles brincam?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_022", "hash": "1261CDC68AC48140", "target": "E eles parecem ter gostado muito de você! Trabalha com filhotes com frequência?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_023", "hash": "F2CDC643184740DF", "target": "Esses bebês são criaturas aquáticas por natureza, mas estamos modificando-os para se adaptarem à vida em terra." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_024", "hash": "215F5F63CDA810F0", "target": "Eles comem principalmente insetos marinhos e mariscos, e alguns dos carnívoros maiores se alimentam deles, por sua vez." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_025", "hash": "1EDE0182F8693F90", "target": "Também carregam os ovos nas costas até estarem prontos para eclodir. Fascinantes, não?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_026", "hash": "9E0DA2B04C0487E2", "target": "Ah, mas você não veio aqui por isso, não é!? Preciso mesmo voltar!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_027", "hash": "F48B8CECB8F532CC", "target": "Obrigado por buscar meu colega." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_028", "hash": "EF95E8EFA741D64A", "target": "Se não tivessem mandado você me buscar, eu poderia ter ficado lá por dias." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_029", "hash": "57C5380D6DDDFA14", "target": "De todo modo, é só uma questão de tempo até nossas criações serem aprovadas para viver na natureza. Que nome será que vão receber...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_030", "hash": "398BD7435BCEA504", "target": "Obrigado por toda a ajuda de hoje. Aqui, como agradecimento." }
  ]
}
