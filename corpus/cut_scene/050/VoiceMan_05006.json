    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000001_OLDTITANIA", "hash": "C563DA51EB6B0615", "target": "Quem vem lá? Foi você que rompeu o selo?" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000002_OLDTITANIA", "hash": "6F06D40A3ADCA366", "target": "Ah, tanto tempo perdido... Tantas brincadeiras e banquetes que ficaram por fazer..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000003_OLDTITANIA", "hash": "0A5521D2E22C6AAA", "target": "Precisamos compensar, precisamos... Começando por brincar com <italic(1)>vocês<italic(0)>!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000010_OLDTITANIA", "hash": "F6750105EA33FFB6", "target": "Não podemos mais... brincar..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000110_VAUTHRY", "hash": "BD6CF9EB7F3ED4EC", "target": "Estão tão decididos a morrer? Uma última chance, vilões: curvem-se e reconheçam seu rei. Seu deus!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000120_VAUTHRY", "hash": "1BB2136161BB98A7", "target": "Mas... eu sou todo-poderoso..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000210_EMETSELCH", "hash": "3164D5E59540FB73", "target": "Mostrem sua força tão “alardeada”. E eu revelarei a mentira da sua existência fragmentada!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000220_EMETSELCH", "hash": "04BF5A9209AB3A78", "target": "Vocês... vocês não têm poder sobre mim!" }
  ]
