    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_PROMPT_BUDDY_RENAME_CAPTION", "hash": "7412C014F5FBEF17", "target": "Nome" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_PROMPT_BUDDY_RENAME_MES0", "hash": "BFB94B02A060AC39", "target": "O nome deve ter de 2 a 20 caracteres alfabéticos. Apóstrofos são permitidos. Hifens são proibidos." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_PROMPT_BUDDY_RENAME_SUCCESS", "hash": "601E31688D183ABE", "target": "Seu chocobo agora se chama <string(lstr1)>." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_CONFIRM_GET_MY_CHOCOBO2", "hash": "E30A46D43F0F5F5B", "target": "A plumagem não mudará de cor se você retirar seu chocobo do estábulo antes da hora. Tem certeza de que deseja retirá-lo?" },
