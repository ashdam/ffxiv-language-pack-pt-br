    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_NOT_TRAIN", "hash": "4581EF7A6E340A24", "target": "Treinar meu chocobo. (Descanso: <if([lnum1>0],<num(lnum1)> min,menos de 1 min)>)" },
