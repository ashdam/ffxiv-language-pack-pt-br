    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_TRAIN_A", "hash": "AE4A10C5C184381C", "target": "Treinar meu chocobo" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_TRAIN_B", "hash": "35576ECD9FF443BF", "target": "Alimentos especiais" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_TRAIN_C", "hash": "3FE9A6A8EDA4E231", "target": "Treinar chocobos de outros jogadores" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CHANGE_COLOR_A", "hash": "526C65131FB1368E", "target": "Petiscos" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CHANGE_COLOR_B", "hash": "BE3FF1FB5025553E", "target": "Restaurar a cor da plumagem" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CLEAN", "hash": "4259C34DDE3E71DA", "target": "Manter o estábulo limpo" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CANCEL", "hash": "A885FEE6F609FE03", "target": "Voltar" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A1", "hash": "AD7313FB940631FB", "target": "Você pode treinar seu chocobo enquanto ele estiver no estábulo para que ganhe EXP de companheiro. Antes de treinar um chocobo, prepare <colortype(500)><edgecolortype(501)>alimento<edgecolortype(0)><colortype(0)> para dar como <colortype(500)><edgecolortype(501)>recompensa<edgecolortype(0)><colortype(0)>." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A2", "hash": "52EF2C86C18BCCCC", "target": "Depois do treino, deixe seu chocobo descansar antes de treiná-lo de novo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A3", "hash": "08FF1F56FA703FF8", "target": "Quando seu chocobo acumular o máximo de EXP de companheiro para o ranque atual, você poderá subir o ranque dele em combate." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A4", "hash": "76929AF23367D297", "target": "Se seu chocobo já estiver no ranque máximo, dê a ele uma Thavnairian Onion após o treino para aumentar esse limite." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A5", "hash": "3B9FCB86782F119F", "target": "Você também pode treinar chocobos de outros jogadores se tiver permissão. O treino não aumenta o ranque máximo deles nem muda seu alimento favorito." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A6", "hash": "D0E9C712B735DF0A", "target": "Os chocobos precisam descansar entre seus treinos. Como reagem bem a estímulos novos, outros membros podem treinar o mesmo chocobo nesse intervalo. Cada pessoa terá de aguardar depois do próprio treino." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B1", "hash": "74903C4F93011FE2", "target": "Certos alimentos dão efeitos benéficos ao seu chocobo quando ele é chamado para lutar." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B2", "hash": "541BCB3277EB9AE2", "target": "Esses alimentos incluem curiel roots, sylkis buds, mimett gourds e pahsana fruits." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B3", "hash": "357BF2597E077D48", "target": "Se você recompensar um chocobo sempre com o mesmo alimento, ele se tornará o <colortype(500)><edgecolortype(501)>alimento favorito<edgecolortype(0)><colortype(0)> dele. Os efeitos benéficos desse alimento serão mais fortes quando o chocobo estiver em combate." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B4", "hash": "79AABE786B539964", "target": "Quando seu chocobo chegar ao ranque máximo, dê a ele uma Thavnairian Onion para aumentar esse limite." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C1", "hash": "37758DEF20F1D0D9", "target": "Você pode treinar chocobos de outros jogadores se tiver permissão." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C2", "hash": "C7FDC3CCF9050886", "target": "Se compartilhar sua propriedade particular com outra pessoa, você pode permitir que ela deixe o próprio chocobo no estábulo e treine os de outros jogadores." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C3", "hash": "C0C0433BCAF12BBE", "target": "Se você tem um apartamento, também pode treinar os chocobos dos moradores do mesmo edifício." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C4", "hash": "C844C32853F44607", "target": "Antes de treinar o chocobo de outra pessoa, espere um tempo depois que ele for deixado no estábulo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C5", "hash": "9EEECFF490A8A4E8", "target": "O treino feito pelo dono do chocobo e o treino feito por outra pessoa contam separadamente. O tempo de descanso de um não afeta o do outro. Além disso, você não pode aumentar o ranque máximo dos chocobos alheios nem mudar o alimento favorito deles." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_1", "hash": "65CE341D5C7375A2", "target": "O treino rende mais quando o estábulo está limpo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_2", "hash": "417F2BE19A5D2088", "target": "Use <colortype(500)><edgecolortype(501)>magicked stable brooms<edgecolortype(0)><colortype(0)> para limpar o estábulo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A1", "hash": "61BA4FE3A4AC3A03", "target": "Para mudar a plumagem do seu chocobo, <colortype(500)><edgecolortype(501)>dê a ele<edgecolortype(0)><colortype(0)> alguns petiscos." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A2", "hash": "0DBC00EB5351633C", "target": "Você pode dar Xelphatol apples, valfruits, Mamook pears, Cieldalaes pineapples, O'Ghomoro berries e Doman plums. Cada petisco afeta a plumagem do chocobo de um jeito diferente." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A3", "hash": "71AD8A350CDCF350", "target": "Depois de dar o primeiro petisco, deixe seu chocobo descansar no estábulo por pelo menos seis horas para que a plumagem mude de cor." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A4", "hash": "A32AD5D845B81472", "target": "Se retirar o chocobo do estábulo antes da hora, a cor não mudará." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_B1", "hash": "66EF1F82F545B2DF", "target": "Dê um Han lemon ao seu chocobo para que a plumagem volte ao amarelo original." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_TITLE", "hash": "6FA0DD41CBF4D0E3", "target": "Selecione uma opção." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_TRAIN", "hash": "C5591BE53F7DCF8C", "target": "Treinar meu chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_FEED", "hash": "59CBB346CBBA6AD6", "target": "Alimentar meu chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_RENAME", "hash": "D80A2C9E5950D4D0", "target": "Renomear meu chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_GET", "hash": "14B4C50D08BF3EE2", "target": "Retirar meu chocobo do estábulo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_DETAIL", "hash": "56E466B048D8DD41", "target": "Examinar chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_CANCEL", "hash": "D42C32B4C894618F", "target": "Voltar." },
