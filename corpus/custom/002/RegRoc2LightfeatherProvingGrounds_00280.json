    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_003", "hash": "DB23D9F9D1E667EC", "target": "Nada." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_010", "hash": "6505D000C77B4A56", "target": "Oficialmente, devo mostrar o lugar e responder às perguntas de quem chega. Na prática, quase não preciso, porque é raro aparecer cara nova por aqui." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_011", "hash": "C1C912FFFAE41AD2", "target": "Por mim, tudo bem. Gosto de ficar livre pra assistir às lutas." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_020", "hash": "ADD7DA9D379ABF65", "target": "Como o nome sugere, o Campo de Provas da Pena Leve foi criado para sediar disputas entre chocobos treinados para o combate." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_021", "hash": "39A14D093F8BB0A0", "target": "Desde então, a Casa Dzemael passou a ceder o espaço para outros usos de vez em quando." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_022", "hash": "7592F5ED27833AD0", "target": "Algumas outras casas já montaram espetáculos, tanto abertos ao público quanto privados. Os Cavaleiros do Templo também já fizeram exibições aqui. Ah, essas são sempre uma maravilha." }
