    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_005", "hash": "D2256CE65A232CF1", "target": "As fichas de que precisa são emitidas em troca de scrips. Se quiser, nossos representantes podem atender você aqui mesmo." },
