    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_000", "hash": "0E04A09A7348ECC8", "target": "A gente chama de “Esplendores” as ferramentas, os equipamentos e outros artigos de qualidade que oferecemos como incentivo aos nossos fornecedores." },
