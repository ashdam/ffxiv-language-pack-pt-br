{
  "conversation": "custom/001/CmnDefAchievementReward_00107",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_001", "hash": "2B976CE8D4508355", "target": "Olá, jovem. Que gentileza fazer um pouco de companhia a um velho gagá como eu. Me diga, gosta de histórias? Eu adoro uma boa história, sobretudo as verdadeiras, contadas por quem as viveu. Se tiver alguma pra contar, sou todo ouvidos." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q1_01", "hash": "DA892CFD8F01B999", "target": "O que você quer fazer?" },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_01", "hash": "5D2F2458E450CBCC", "target": "Receber recompensa de conquista." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_02", "hash": "5E225F3E99C67EA7", "target": "Perguntar sobre Jonathas." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_03", "hash": "A2D205B55D3A00A4", "target": "Nada." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_04", "hash": "D8FD83291FF541EB", "target": "Trocar certificado de conquista." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_010", "hash": "3A960A4939A78579", "target": "Quando eu era jovem, tive a honra de trabalhar como escriba da corte. Ah, os bons tempos em que meus olhos ainda enxergavam bem e a família real ainda detinha o verdadeiro poder em Ul'dah." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_011", "hash": "DBD11954C54799AA", "target": "Mal passava um dia sem que o palácio real explodisse num arco-íris de cores, com cerimônias grandiosas e banquetes suntuosos. Hoje em dia, porém, o que mais me encanta são os relatos de aventuras e façanhas de verdade." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_012", "hash": "F3D23A25CC398658", "target": "Se você já fez alguma coisa que lhe dê orgulho, eu gostaria muito de ouvir sua história. Quem sabe eu até lhe dê uma lembrancinha em troca." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_013", "hash": "A83E65B686B18198", "target": "Algumas conquistas concedem recompensas. Fale com Jonathas para recebê-las." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_010_031", "hash": "45B20D68D47AEBCA", "target": "Cada conquista concluída rende pontos de conquista. Ao acumular a quantidade necessária, você recebe um certificado de conquista." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_030", "hash": "1F7B9CA3E08C6F4C", "target": "Suas façanhas dariam aos bardos assunto pra cantar a vida toda, <if(gnum4,moça,rapaz)>. Tal proeza merece reconhecimento, por isso quero que aceite isto. Considere um sinal da minha mais alta estima." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_031", "hash": "116D15C33C0797A6", "target": "Você recebeu um certificado de conquista pelos pontos de conquista que acumulou." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_032", "hash": "37347483A0D34E24", "target": "Fale com Jonathas para trocar certificados por uma recompensa especial à sua escolha." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q4_01", "hash": "DA640115075B3106", "target": "Selecione uma categoria de conquista." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_01", "hash": "8CC0BF668FCDC3E5", "target": "<sheet(AchievementKind,1,0)>." },
