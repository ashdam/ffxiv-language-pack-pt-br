    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_PLD_SUB_WEAPON", "hash": "A0F977A5ABE9280D", "target": "Livros sobre escudos." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_MAIN_PLD", "hash": "3244B45E981B0315", "target": "Livros do Fogo (aumentam <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SUB_PLD", "hash": "C6DAD0C895CC1030", "target": "Livros da Cascata (aumentam <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SELECTION_A_PLD", "hash": "6734290ABF5E800E", "target": "Livros do Vento (aumentam <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SELECTION_B_PLD", "hash": "12F3D83B75B99413", "target": "Livros da Terra (aumentam <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_MAIN_PLD_SUB", "hash": "9F984757A5E04E94", "target": "Book of Netherfire (aumenta <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SUB_PLD_SUB", "hash": "B827E13CC940854E", "target": "Book of Netherfall (aumenta <sheet(BaseParam,lnum1,1)>). Progresso: <num(lnum2)> de <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_030", "hash": "8E366CB91234A674", "target": "Eu disse que cada coleção tem nove livros, mas também existem séries <italic(1)>diferentes<italic(0)>. Dei uma folheada e parece que cada uma trata de uma arma específica. Se tiver alguma preferência, é só dizer." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_0000_SYSTEM_000_035", "hash": "EEDFEA5CE33ED36F", "target": "Ações valem mais que palavras. Equipe a arma relicária Atma que deseja aprimorar e fale outra vez com G'jusana." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_040", "hash": "B8C7E62540C3E2C8", "target": "...Hum? Parece que acabaram todos os livros sobre essa arma. Também não é surpresa, foi você que levou todos!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_045", "hash": "D18D6FFDC7F7B450", "target": "Você já concluiu todas as provações da arma relicária Atma equipada. Vá a Hyrstmill e apresente-a a Jalzahn." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_050", "hash": "92B74490A9ACACD3", "target": "Parece que você já leu todos os livros dessa categoria. Quer ver outra coisa?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_060", "hash": "216AD2071E11DCC4", "target": "Espere... Não <italic(1)>acabei<italic(0)> de vender um livro pra você? Eu bem que gostaria de oferecer outro, mas acho que estaria fazendo um desserviço. Pense assim: quanto mais se tem, menos se dá valor!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_065", "hash": "2EFB953AB91FFE65", "target": "Conclua todos os objetivos de um livro antes de comprar outro. Você também pode descartá-lo falando com G'jusana ou pelo menu Itens-chave." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_070", "hash": "A16494D70CCA466F", "target": "Aqui está o livro que você tanto queria. Tenho certeza de que vai render horas e horas de diversão! Já viu 100 <ennoun(Item,3,\u300028,2,1)> serem tão bem gastos? Eu duvido!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_075", "hash": "FCEA2D19483E5F3F", "target": "Você obteve um livro das Provações dos Bravos. Use o livro no menu Itens-chave para consultar seus objetivos." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_Q", "hash": "5A48B4ED91DA27C2", "target": "Trocar <kilo(lnum3,.)> <ennoun(Item,3,lnum2,2,1)> por <ennoun(EventItem,3,lnum1,1,1)>?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_Q2", "hash": "163907E82CBFF6C9", "target": "A arma que você tem não corresponde ao seu progresso nas provações. Deseja descartar <ennoun(EventItem,3,lnum1,1,1)> e comprar <ennoun(EventItem,3,lnum2,1,1)> por <kilo(lnum4,.)> <ennoun(Item,3,lnum3,2,1)>?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_YES", "hash": "B6A0C7ACE6ED409A", "target": "Sim" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_NO", "hash": "997C5006405F242A", "target": "Não" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_080", "hash": "98384A0D272EC202", "target": "Poxa, parece que você não tem <ennoun(Item,3,\u300028,2,1)> suficientes. Não posso cobrar menos de 100 por textos tão valiosos. Pense assim: quanto mais trabalho dá conseguir algo, mais valor você dá!" }
  ]
}
