    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_000", "hash": "FB79777DB78D605E", "target": "Veio aproveitar minha oferta especial, né? Qual livro das Provações dos Bravos você quer comprar?" },
