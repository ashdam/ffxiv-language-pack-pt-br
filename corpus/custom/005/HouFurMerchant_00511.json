    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE1", "hash": "7DD3CEDEA0BA0800", "target": "Aqui estou, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE2", "hash": "5A62FE8EAF415E5D", "target": "Pode deixar comigo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE3", "hash": "CE00F65C00EBC5BE", "target": "Chamou?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE4", "hash": "859B08A2503A5AAE", "target": "Pois não? \\<suspiro> Espero que não demore..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE5", "hash": "F638B81C23CDA6FF", "target": "Quer ver como se toma conta de uma banca de verdade?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE6", "hash": "5AE55FA7CC9C0621", "target": "Olá, olá! Chamou?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE1", "hash": "F5C949592DDFEC3B", "target": "Às suas ordens, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE2", "hash": "012F7F46513EB2D9", "target": "O que vai ser desta vez, meu bem?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE3", "hash": "7C7B9158EC1A110C", "target": "O que deseja?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE4", "hash": "52F62D6DA83D4308", "target": "Queira perdoar a demora, <if(gnum4,senhora,senhor)>. Mil desculpas." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE5", "hash": "1E8A617D04953C1B", "target": "Vamos, depressa. Tenho mais a fazer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE6", "hash": "B9571B5551F411DE", "target": "Ora, se não é minha pessoa favorita! Sempre um prazer, <if(gnum4,senhora,senhor)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE1", "hash": "2AB8C1FBE249A401", "target": "Sim, <if(gnum4,senhora,senhor)>? Quais são suas ordens?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE2", "hash": "D58014FF6C45B694", "target": "Qual é o plano, chefe? Separar os trouxas do gil que suaram pra ganhar?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE3", "hash": "82FD2BB233D9BE05", "target": "Cheguei. Pode prosseguir." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE4", "hash": "17AB77EC51236518", "target": "Ah, olá. A que devo o prazer?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE5", "hash": "BDF39A6397039511", "target": "Vim tratar de negócios. Só de negócios." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE6", "hash": "3C7C0EACC41411D0", "target": "Que bom ver que está bem de saúde, <if(gnum4,senhora,senhor)>. Em que posso ajudar nesta bela <if([gnum11<12],<if([gnum11<4],noite,manhã)>,<if([gnum11<17],tarde,noite)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE1", "hash": "9E1295E7AC4B9C21", "target": "O que deseja que eu faça, <if(gnum4,minha dama,meu senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE2", "hash": "7D3FC139E86984E1", "target": "Em geral, sou eu que chamo e os outros que esperam." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE3", "hash": "ED24FF5DA930F1A4", "target": "Em que posso ajudar?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE4", "hash": "902F16D65FE73B8C", "target": "Ah, por que tinha de me chamar logo agora...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE5", "hash": "C06BBA87E06578C8", "target": "Tenho certeza de que há uma ótima explicação para este chamado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE6", "hash": "B1C5B59644878380", "target": "Sabe que eu já esperava seu chamado? Pode contar comigo, estou a postos e à sua disposição." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE1", "hash": "D1D730C68C6DEC11", "target": "Saudações, <if(gnum4,senhora,senhor)>. Seu humilde servo atendeu ao chamado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE2", "hash": "F84C47511BA25E9A", "target": "Saudações e cumprimentos, <if(gnum4,minha dama,meu senhor)>. Diga o que quer e eu vou fazer de tudo pra conseguir." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE3", "hash": "796B673E9A13C265", "target": "Já estava me perguntando quando ia me chamar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE4", "hash": "8CF9411B6556587D", "target": "Podemos ser breves? Tem uma belezinha me esperando." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE5", "hash": "00FF44E6FC84A0C2", "target": "O quê?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE6", "hash": "4BF98D696634555A", "target": "Cheguei, cheguei!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE1", "hash": "C274C397AD53CB55", "target": "Aqui estou, <if(gnum4,senhora,senhor)>, conforme seu pedido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE2", "hash": "612E4AD32C521C44", "target": "Olá, meu bem. O que temos pra hoje?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE3", "hash": "B8B60A6D01456F11", "target": "Nunca perco uma chance de encher estes bolsos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE4", "hash": "8D1865E0370A49A5", "target": "Ora, que surpresa! O que vai ser?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE5", "hash": "2F5E335CA2862111", "target": "O que foi agora?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE6", "hash": "970A04EB398CB378", "target": "Chegueeeeei!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE1", "hash": "5E1F967DF05D820C", "target": "Em que posso serrrvir, <if(gnum4,senhora,senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE2", "hash": "B14A234DB7837713", "target": "É uma guerra lá fora, <if(gnum4,senhorita,senhor)>. Você não faz ideia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE3", "hash": "5905787E93C032F7", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE4", "hash": "3F43AD9F909D6289", "target": "Negócios ou prazer?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE5", "hash": "B3674C9612925B93", "target": "Presumo que não tenha me chamado só pelo prazer da minha companhia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE6", "hash": "F547E9C270766A63", "target": "Era <if(gnum4,essa linda donzela,esse belo rapaz)> que eu esperava ver! Diga o que seu coração deseja." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE1", "hash": "CD2FB037367201E6", "target": "Espero que esse miado não seja de desaprovação." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE2", "hash": "0F20EAB84B905EEE", "target": "Chamou, <if(gnum4,minha dama,meu senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE3", "hash": "9BF08255180A7428", "target": "Pouca coisa escapa às orelhas de um gato. Um chamado, então, nem pensar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE4", "hash": "BCFBAF5F1F836346", "target": "Foi a curiosidade que chamou o gato? O que temos para hoje?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE5", "hash": "20D400D64318A1E8", "target": "É só dizer quando." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE6", "hash": "AB7245A1A5361A50", "target": "Estava pensando em você agora mesmo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE1", "hash": "DC7509EFD4EE906B", "target": "De que precisa hoje, <if(gnum4,senhora,senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE2", "hash": "0F74038BDDC1274B", "target": "Bua-ha-ha-ha! Tem trabalho pra fazer? É só apontar a maldita direção." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE3", "hash": "EA201EF608AEFADC", "target": "Cheguei. O que foi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE4", "hash": "2CA66C9D8A3A5E8B", "target": "Olá, hic, <if(gnum4,garota,companheiro)>! Quer tomar uma cerveja comigo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE5", "hash": "86D3758D6307C489", "target": "Vim assim que pude. Cadê o trabalho?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE6", "hash": "6B02C3F1AF4A2B25", "target": "Vim correndo assim que ouvi o sino! Precisa de alguma coisa, chefe?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE1", "hash": "4CC428F6640E9C71", "target": "Estou à sua disposição, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE2", "hash": "3A635206D530D151", "target": "Tem algo pra mim, capitão?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE3", "hash": "514CB62E02D15C66", "target": "Pode falar, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE4", "hash": "750F501436084153", "target": "Vamos direto ao assunto, pode ser?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE5", "hash": "9EEC19972F7A1AB8", "target": "Nada disso seria preciso se você me confiasse suas finanças." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE6", "hash": "0923F1B49CF66C2E", "target": "Então, vender, comprar, beber, ir ao bordel? O que vai ser hoje?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE1", "hash": "69E2C419843E145B", "target": "Saudações, <if(gnum4,senhora,senhor)>. Em que posso servir?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE2", "hash": "AFC46CAC3F1B77CF", "target": "O que vai ser, <if(gnum4,senhorita,companheiro)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE3", "hash": "BEF93F1846E7D792", "target": "Diga a que veio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE4", "hash": "6F6244639104247D", "target": "E como vai você <if([gnum11<12],<if([gnum11<4],nesta noite maravilhosa,neste dia maravilhoso)>,<if([gnum11<17],neste dia maravilhoso,nesta noite maravilhosa)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE5", "hash": "CE3347D641BAB9FD", "target": "Bem... Aqui estou... <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE6", "hash": "8BC9D106BD0609B5", "target": "Trabalhamos no mercado,♪<br>De uniforme impecável.♪<br>Sóbrios e de honra em dia,♪<br>Com atenção e cortesia!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE1", "hash": "1A4D886EA936445D", "target": "<if(gnum4,Minha dama,Meu senhor)>. O que deseja de mim?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE2", "hash": "415B5CF8E4F87007", "target": "Então. Vamos nessa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE3", "hash": "EC8C44309097A931", "target": "Sim?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE4", "hash": "60E22049088269DE", "target": "Ei, é... é você! Olá de novo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE5", "hash": "8498C894B22C4603", "target": "N-não é como se eu quisesse vender seus itens nem nada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE6", "hash": "44E20E73EDEB780E", "target": "O que tem pra mim? Vamos, vamos! Nada de timidez!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE1", "hash": "8A083E1A6FD76849", "target": "Chamou, <if(gnum4,minha dama,meu senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE2", "hash": "2E65686EF7AC1A78", "target": "Espero que valha a pena." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE3", "hash": "59E897BE3EA9B59A", "target": "<italic(1)>O quê<italic(0)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE4", "hash": "2487E7ACF5239240", "target": "Do que precisar, deixe comigo! Tenho meus métodos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE5", "hash": "938D05EC6A512509", "target": "Ga-ha-ha! Ora, se não é <if(gnum4,minha senhora favorita,meu senhor favorito)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE6", "hash": "7C84CB32D00AEABD", "target": "Sou eu, seu ajudante mais leal e competente!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE1", "hash": "7425F30367D9CFDF", "target": "O que vai ser, meu bem?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE2", "hash": "3695A28EF246A58C", "target": "Suas ordens! Quero ouvi-las agora mesmo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE3", "hash": "190B34BAEFE15AC7", "target": "Se tem algo a me pedir, peça." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE4", "hash": "20CC450A51D26342", "target": "Sim...? Você, \\<bocejo>... precisa de algo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE5", "hash": "FA8EE46ECAD554D5", "target": "Uma tarefa para mim? Espero que seja divertida!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE6", "hash": "D4537748FEA28406", "target": "Estou aqui para cumprir suas ordens, <if(gnum4,senhora,senhor)>! Peça o que quiser!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE1", "hash": "3B4F2478F64B414D", "target": "Eu estava à espera do seu chamado, <if(gnum4,senhora,senhor)>. O que deseja de mim nesta bela <if([gnum11<12],<if([gnum11<4],noite,manhã)>,<if([gnum11<17],tarde,noite)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE2", "hash": "5F56E6E9F8174AE6", "target": "O que posso fazer por Vossa <if(gnum4,Senhoria,Senhoria)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE3", "hash": "AE1FBFC5AE9B7F14", "target": "Chamou, <if(gnum4,senhora,senhor)>...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE4", "hash": "C6300B9819E9144C", "target": "Você, hic, chamou?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE5", "hash": "88BD26F9FFF475AF", "target": "Precisa da minha ajuda? Vamos ser rápidos, então." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE6", "hash": "81A814A7B1D7A52D", "target": "Tem a minha atenção, <if(gnum4,minha dama,meu senhor)>. Os dois ouvidos, para falar a verdade!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE1", "hash": "BEABDBFBE0D456A5", "target": "Chamou, <if(gnum4,senhora,senhor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE2", "hash": "497DF99CF329948B", "target": "É só chamar que eu venho!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE3", "hash": "F5AB8C10D40B23CA", "target": "Você chamou e eu vim." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE4", "hash": "EDAB70F474EDE4DC", "target": "Até que enfim! Achei que <italic(1)>nunca<italic(0)> fosse me chamar. De que <if(gnum4,minha dama,meu senhor)> precisa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE5", "hash": "B8811F3FDA5013F0", "target": "Será mesmo...? A celebridade <split(<string(gstr1)>, ,1)> chamou justo por <italic(1)>mim<italic(0)>? \\<risadinha>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE6", "hash": "0FEF2A4C857E019F", "target": "Sim, sim, aqui estou! Sempre a postos!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE1", "hash": "88D463EC8F658FA7", "target": "Se era só isso, vou me retirar, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE2", "hash": "849D81FC7DAD90B3", "target": "Se cuida, ouviu?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE3", "hash": "E1099B5E7A356733", "target": "Até nosso próximo encontro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE4", "hash": "3FB6CD3E06EC78BE", "target": "Bem, já não era sem tempo. Até logo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE5", "hash": "F24FB14000CF01A7", "target": "Acho que mereço um agradecimento." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE6", "hash": "4A02FE143E4553C2", "target": "Vou nessa, então!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE1", "hash": "A1D16E93FE280EE5", "target": "Com licença, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE2", "hash": "EA2E1ABB7A29A1F0", "target": "Não se preocupe com nada. Deixe comigo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE3", "hash": "893A335E51F1497D", "target": "Até logo, então." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE4", "hash": "0C503B4EBE46A5BC", "target": "Se não houver mais nada, <if(gnum4,senhora,senhor)>, vou me retirar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE5", "hash": "0372772E633E82A8", "target": "Era só isso? Muito bem, até a próxima." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE6", "hash": "C4E9F6F39D7CAC42", "target": "Ah, por hoje é só? Tudo bem, mas prometa que vai voltar logo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE1", "hash": "6ECC28A5A20CFF53", "target": "Como sempre, <if(gnum4,senhora,senhor)>, foi uma honra e um privilégio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE2", "hash": "334707F26ED0F881", "target": "Pode contar comigo, chefe. Eu sei como resolver as coisas." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE3", "hash": "3A5B427C8D71EADF", "target": "Apareça mais vezes." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE4", "hash": "AB2D78180890554D", "target": "Juro que farei isso. Uma hora dessas." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE5", "hash": "6E233E5428D80033", "target": "Como desejar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE6", "hash": "6FFEB5415F61E4EF", "target": "Esplêndido! Cumprirei suas ordens sem demora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE1", "hash": "60FFCA2960EDF641", "target": "Aguardo humildemente seu próximo chamado, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE2", "hash": "EE70BF1D65137631", "target": "Não me deixe sem companhia por muito tempo, ouviu?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE3", "hash": "AFF49D7A5FFE694F", "target": "É sempre um prazer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE4", "hash": "E9A09D8DFF23EC4A", "target": "Isso é tudo, certo? Então, com licença..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE5", "hash": "F255DE42810E1852", "target": "Acho que encerramos nossos negócios por ora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE6", "hash": "6D8EE315750B9273", "target": "Não quer mais nada mesmo? Nadinha? Muito bem, vou me retirar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE1", "hash": "01A81DD41FBC9E36", "target": "Seus desejos serão atendidos sem demora, com todo o cuidado e atenção." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE2", "hash": "5BF7B95AC3847613", "target": "Não deve demorar nada, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE3", "hash": "E09DE56E4D72C33C", "target": "Vou indo, então." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE4", "hash": "B208AF9A6ADB7064", "target": "Graças aos deuses, terminamos. Tenho planos de pôr as mãos em lugares que nunca vi... se é que você me entende." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE5", "hash": "6A30C711FF4F87AC", "target": "Passe bem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE6", "hash": "0092D04A83F9E6C9", "target": "Já vou, já vou!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE1", "hash": "DF69E40794DFE5FF", "target": "Até nos encontrarmos de novo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE2", "hash": "99CFC19E40715296", "target": "Que os Doze lhe deem suas bênçãos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE3", "hash": "9CD78DADB67CBFFF", "target": "Que Nald'thal se digne a encher nossos bolsos!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE4", "hash": "9EAB87FFF6DE0A5C", "target": "Muito bem, <if(gnum4,senhora,senhor)>! Seu desejo é uma ordem e tudo mais." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE5", "hash": "7018FB750ECE9AC9", "target": "Você sabe onde me encontrar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE6", "hash": "6C57F9571D77D01A", "target": "Já é hora de dizer adeus? Vou sentir sua falta..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE1", "hash": "69A1455EE27222E0", "target": "Que se cumpra a vossa vontade." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE2", "hash": "667F50DAFC05A4DB", "target": "O mercado pode ser um maldito campo de batalha, mas eu vivo é de guerra. Pode contar comigo, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE3", "hash": "38CCA131983915D1", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE4", "hash": "804330C723245237", "target": "Por que tanta serrriedade? \\<suspiro> Fazer o quê." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE5", "hash": "B59127539CDD2BFD", "target": "Acho difícil acreditar que isso exigia minha presença, mas o que está feito está feito." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE6", "hash": "D32B63CEF4C6D9BB", "target": "Satisfiz todos os seus desejos, então? Excelente! Servir à clientela me dá tanto prazer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE1", "hash": "22414922F1935BF1", "target": "Até logo, <if(gnum4,senhora,senhorrr)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE2", "hash": "108B6F2259B60130", "target": "Certo, mãos à obra!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE3", "hash": "52DE8CE9A6D8E20F", "target": "Não há motivo pra se prreocupar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE4", "hash": "290EF929E78637B8", "target": "Quando o mestre sai, o gato faz a festa." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE5", "hash": "FA8C7C6065ED53D2", "target": "Pelos deuses, isso cansa..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE6", "hash": "DE8DA50F9F8D2F27", "target": "Já não quer mais minha companhia? \\<fungada>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE1", "hash": "418E2CED424D412C", "target": "Seus desejos serão cumpridos à risca, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE2", "hash": "A7F32FBEAEAE1CD7", "target": "Bua-ha-ha-ha! Tô na sua banca vendendo suas coisas!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE3", "hash": "596A086169C8620D", "target": "Vou me retirar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE4", "hash": "1FE03AB6FA4EF373", "target": "Ah, droga. Acho melhor ir trabalhar..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE5", "hash": "5CA5DCD20541D622", "target": "Não sou de dizer adeus." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE6", "hash": "18485E817E9798B3", "target": "Vá tirar um cochilo, chefe. Você tá com uma cara horrível!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE1", "hash": "D50869DEEA72EAFE", "target": "Isso é tudo por hoje, <if(gnum4,minha dama,meu senhor)>? Entendido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE2", "hash": "2726DC3430FFBA96", "target": "Sim, sim, capitão!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE3", "hash": "6EBDC0D3C0F81F8E", "target": "Devidamente anotado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE4", "hash": "54DBADDD740606F3", "target": "Não era bem assim que eu esperava passar o dia, mas fazer o quê." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE5", "hash": "7240C430DA6E781B", "target": "Não nos cabe perguntar por quê. Só cumprir a missão e morrer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE6", "hash": "6684A74D00421F25", "target": "Vejo que continua um modelo de profissionalismo. Até outra hora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE1", "hash": "C90E7BD661A1A30E", "target": "Se não houver mais nada, vou me retirar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE2", "hash": "4339ABC23A6F44A2", "target": "Era só isso? Acho que vou nessa, então." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE3", "hash": "1D1B916C6F3A51FB", "target": "Algum último pedido? Muito bem. He, he, he... Ahem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE4", "hash": "743EEE2C92662B7E", "target": "Ah, sim, claro. O dever chama!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE5", "hash": "BBAE10CEC574F875", "target": "Já terminou comigo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE6", "hash": "8D85563251905149", "target": "Hoje aqui, amanhã já não.♪<br>Sim, eu sei.♪<br>É assim!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE1", "hash": "242AEA23EBED69FE", "target": "Se precisar de mim, é só tocar o sino." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE2", "hash": "B561EBF9455B518A", "target": "É sempre um prazer, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE3", "hash": "20204685B662AD42", "target": "Pois bem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE4", "hash": "74CDBCCD81DB5BCD", "target": "Já terminou? Então é isso, pelo visto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE5", "hash": "B2F10572DA703959", "target": "Já vai embora? Tudo bem! N-não é como se eu quisesse que ficasse nem nada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE6", "hash": "190A5792CC613B94", "target": "Muito bem, <if(gnum4,senhora,senhor)>! Muito bem mesmo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE1", "hash": "0CDF98D15F0140D2", "target": "É sempre um prazer servir, <if(gnum4,minha dama,meu senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE2", "hash": "6CF858424E547F48", "target": "Humph. Espero que da próxima vez tenha uma tarefa mais importante para mim." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE3", "hash": "1B098026D0C1AF7C", "target": "<italic(1)>Adeus<italic(0)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE4", "hash": "8CA330509327D281", "target": "E com isso, vou indo. Tenho lugares aonde ir, gente para ver." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE5", "hash": "BFA406B47E85CE14", "target": "Ba-ha-ha-ha! Até a próxima!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE6", "hash": "7CFECEDB1D62B750", "target": "Toque o sino quando quiser! Você sabe que nunca vou deixar você na mão!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE1", "hash": "AEEE2C0A3BEA4681", "target": "Temos de nos despedir tão cedo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE2", "hash": "7D84B777BCB5A896", "target": "E lá vou eu!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE3", "hash": "4580EE2773C12030", "target": "Chame quando quiser. Se eu estiver a fim, respondo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE4", "hash": "52EC9A9CA2925BA2", "target": "Era só isso, suponho...? \\<bocejo> Muito bem..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE5", "hash": "CF979F188FA5FD94", "target": "Era só isso? Ah, eu esperava que tivesse mais..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE6", "hash": "9DFB282B9E8A396B", "target": "É tudo de que precisa? Mas ainda posso servir você de tantas maneiras!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE1", "hash": "8D41CD2616D593CA", "target": "Não hesite em me chamar de novo. Boa sorte no que fizer, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE2", "hash": "8EE855ACB28966EB", "target": "É só dar a palavra, <if(gnum4,minha dama,meu senhor)>, que eu venho correndo quando tocar o sino." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE3", "hash": "323C3622A19961A8", "target": "Se já não precisa dos meus serviços..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE4", "hash": "4296B8FB1223B597", "target": "Vou tomar mais um copo, então. Você sabe onde me achar!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE5", "hash": "59D5A545495AEFA2", "target": "O quê, era só isso? Tem <italic(1)>certeza<italic(0)> de que precisa de um ajudante?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE6", "hash": "E2EC97966E1A318B", "target": "Mais nada? Então vou dando o fora aos pulinhos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE1", "hash": "F8740AD6E1165066", "target": "Fico feliz por ter sido útil. Não exagere no trabalho, <if(gnum4,senhora,senhor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE2", "hash": "421BFCBABFED884B", "target": "Já se cansou de mim, foi? Justo! Se precisar de mais alguma coisa, avise!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE3", "hash": "39312F369BCC7E1C", "target": "Terminamos? Então, com licença." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE4", "hash": "1089923CA3E0BAAA", "target": "<if(gnum4,Minha dama,Meu senhor)> não precisa de mais nada? Vou afiar as garras enquanto espero o próximo chamado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE5", "hash": "DE833458A602DCB5", "target": "Mais nada? Certo... Vou nessa!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE6", "hash": "2A697BAEF75219E1", "target": "Já tem tudo de que precisa? Então vou tirar uma soneca." }
  ]
}
