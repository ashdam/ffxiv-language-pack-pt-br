    { "gameKey": "custom/005/CmnDefRetainerMarketRegister_00581#TEXT_CMNDEFRETAINERMARKETREGISTER_00581_CASHBACK_ASK_ABOUT", "hash": "E6299C7993BB86F0", "target": "Saiba mais sobre as taxas do mercado" },
