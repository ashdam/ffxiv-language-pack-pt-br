    { "gameKey": "custom/005/CmnDefRetainerMarketRegister_00581#TEXT_CMNDEFRETAINERMARKETREGISTER_00581_MAIN_MENU_ABOUT_01", "hash": "8AF2F83AE71E7730", "target": "O mercado do Crystarium está longe de ser grande, mas você pode vender seus artigos aqui à vontade." },
