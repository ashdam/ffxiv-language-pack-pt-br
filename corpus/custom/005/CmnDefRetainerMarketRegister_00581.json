    { "gameKey": "custom/005/CmnDefRetainerMarketRegister_00581#TEXT_CMNDEFRETAINERMARKETREGISTER_00581_DEFAULT_TALK_01", "hash": "EE18357C63E8CE43", "target": "Ah, <string(gstr1)>. Boas-vindas a Musica Universalis. Em que posso ajudar?" },
