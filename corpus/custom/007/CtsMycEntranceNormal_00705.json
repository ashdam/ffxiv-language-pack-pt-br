    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SERAOUSH_000_000", "hash": "F434B14FAA53ED7E", "target": "Creio que não há um só soldado em toda a Resistência que ainda não tenha ouvido falar dos seus feitos na frente sul." },
