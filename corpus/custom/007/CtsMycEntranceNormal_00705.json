    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_010", "hash": "27480C3D906783F2", "target": "Você precisa de <kilo(lnum1,.)> de Mettle para chegar à próxima patente da Resistência." },
