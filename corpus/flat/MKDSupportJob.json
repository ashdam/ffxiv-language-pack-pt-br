    { "gameKey": "MKDSupportJob#7.3", "hash": "9CA0BD2D2881BBBC", "target": "As lembranças deste geomante transbordam uma compreensão ilimitada das leis da natureza. Acesse-as para empregar técnicas que dependem do clima." },
    { "gameKey": "MKDSupportJob#7.4", "hash": "B35CECE4CF63F8D8", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#8.0", "hash": "831F8E32CA8D8E00", "target": "Phantom Time Mage" },
