    { "gameKey": "MKDSupportJob#3.3", "hash": "E417CA80B42BF051", "target": "Estas memórias da disciplina inabalável e da meditação silenciosa de um monge oferecem um caminho para um domínio inigualável do combate." },
    { "gameKey": "MKDSupportJob#3.4", "hash": "6051667EAF00102B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#4.0", "hash": "065E7EE7FD1AA355", "target": "Phantom Ranger" },
