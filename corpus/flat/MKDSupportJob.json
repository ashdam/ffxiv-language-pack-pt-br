    { "gameKey": "MKDSupportJob#1.3", "hash": "CB4EAD52D55681A1", "target": "Reproduza estas antigas memórias de um cavaleiro leal e honrado e proteja seus companheiros do perigo." },
    { "gameKey": "MKDSupportJob#1.4", "hash": "17736741DE595AC3", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#2.0", "hash": "8A42DD63A3ACF012", "target": "Phantom Berserker" },
