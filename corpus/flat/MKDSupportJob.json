    { "gameKey": "MKDSupportJob#0.3", "hash": "3953277178CB9660", "target": "Lembranças de jornadas recém-iniciadas e de outras há muito encerradas dão forma às inúmeras técnicas de apoio do aventureiro independente." },
    { "gameKey": "MKDSupportJob#0.4", "hash": "412B1D804A96C865", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#1.0", "hash": "C30351012BBD5294", "target": "Phantom Knight" },
