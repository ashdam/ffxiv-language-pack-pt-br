    { "gameKey": "MKDSupportJob#6.3", "hash": "4AEE4A89EAF12ED2", "target": "Estas memórias ecoam com as imagens vívidas da canção melodiosa de um bardo. Use-as para empregar essas mesmas baladas em batalha." },
    { "gameKey": "MKDSupportJob#6.4", "hash": "678FD76402DFA2FD", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#7.0", "hash": "59D75D44C52FCB24", "target": "Phantom Geomancer" },
