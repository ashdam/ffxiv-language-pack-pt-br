    { "gameKey": "MKDSupportJob#10.3", "hash": "AEC479FDD0A03016", "target": "As memórias deste boticário oferecem conhecimento de antigas teorias medicinais, incluindo técnicas restauradoras que certamente virarão a batalha a seu favor." },
    { "gameKey": "MKDSupportJob#10.4", "hash": "D3FC862A930971C4", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#11.0", "hash": "87E4C2A262E3EA1C", "target": "Phantom Oracle" },
