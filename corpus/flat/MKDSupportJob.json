    { "gameKey": "MKDSupportJob#4.3", "hash": "A8D4B3F06ADAF857", "target": "Canalize estas memórias de um patrulheiro orgulhoso e apaixonado e aprenda a invocar as forças da natureza em batalha." },
    { "gameKey": "MKDSupportJob#4.4", "hash": "83A1E8B0063A048F", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#5.0", "hash": "C1202425AB9661AB", "target": "Phantom Samurai" },
