    { "gameKey": "MKDSupportJob#5.2", "hash": "18945F66F9422797", "target": "", "intentionalEmpty": true },
    { "gameKey": "MKDSupportJob#5.3", "hash": "AAEC0E4F6CD5B280", "target": "Treinamento rigoroso e um código estrito de cavalaria personificam estas lembranças de um antigo samurai. Acesse-as para abater inimigos com um único golpe mortal." },
    { "gameKey": "MKDSupportJob#5.4", "hash": "FE05F616139A5E46", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#6.0", "hash": "589CD9793E04FCCF", "target": "Phantom Bard" },
