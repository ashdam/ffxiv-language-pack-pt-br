    { "gameKey": "MKDSupportJob#2.2", "hash": "2D6CBC4E19C6165B", "target": "", "intentionalEmpty": true },
    { "gameKey": "MKDSupportJob#2.3", "hash": "E669094F2B1A4CD3", "target": "A ferocidade e a coragem inabalável caracterizam as lembranças deste antigo berserker. Essas técnicas envolvem grandes riscos e recompensas ainda maiores." },
    { "gameKey": "MKDSupportJob#2.4", "hash": "6ECCC42B7579E461", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#3.0", "hash": "C2D12FB2C9B6A31B", "target": "Phantom Monk" },
