    { "gameKey": "MJIText#46", "hash": "4C4EA395B83506EF", "target": "Floração" },
    { "gameKey": "MJIText#47", "hash": "57BCF7DA36FF35AF", "target": "Sua primeira base nesta terra selvagem, erguida às pressas com materiais recolhidos pela ilha." },
    { "gameKey": "MJIText#48", "hash": "B1C0E2B1B3F85B45", "target": "O coração das suas atividades na ilha, com um toque de aconchego além do básico." },
    { "gameKey": "MJIText#49", "hash": "5423FBD015B63289", "target": "A peça central do seu próspero empreendimento na ilha, totalmente reformada por mammets habilidosos em carpintaria." },
    { "gameKey": "MJIText#50", "hash": "BA22E7D21BB11B67", "target": "Quatro paredes e um teto, onde seus mammets trabalham com todo o entusiasmo na fabricação de artigos artesanais." },
    { "gameKey": "MJIText#51", "hash": "7A9448F6945BC14F", "target": "Uma instalação modesta, mas funcional, onde seus confiáveis mammets produzem artigos artesanais." },
    { "gameKey": "MJIText#52", "hash": "80A1EA805EDCAAEF", "target": "Uma oficina imponente, projetada sob medida para mammets profissionais do artesanato." },
    { "gameKey": "MJIText#53", "hash": "77E28AB2D227CF9B", "target": "Um depósito simples para guardar materiais da ilha e reunir os mammets antes das expedições." },
    { "gameKey": "MJIText#54", "hash": "D8E980370B3409C7", "target": "Uma instalação com espaço de armazenamento e recursos suficientes para manter uma equipe confiável de mammets coletores." },
    { "gameKey": "MJIText#55", "hash": "BE5204087E12FC77", "target": "Um amplo depósito da ilha, com estrutura profissional e uma equipe de mammets coletores de elite." },
    { "gameKey": "MJIText#56", "hash": "C42037F5AE413FF9", "target": "Um terreno vazio cheio de possibilidades para construir." },
    { "gameKey": "MJIText#57", "hash": "C9682342FB85033E", "target": "Por mais que você sonhe alto, essas pás gigantes só giram para mover o moinho que mói seus grãos. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#58", "hash": "0F5C82B39126B04E", "target": "Um esconderijo sossegado entre os galhos altos e verdes. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#59", "hash": "1ACC370C77083739", "target": "Os autômatos encarregados da temperatura têm boas intenções. Segundo eles, esse belo banho ao ar livre vai queimar todas as impurezas da sua pele e deixar você tinindo... se sobreviver. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#60", "hash": "4DD06BE263B87A25", "target": "Foi preciso muito esforço para construir este farol no estilo lominsano, com poucos materiais e muita discussão entre os mammets responsáveis pelo projeto. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#61", "hash": "F23D90896867CBEF", "target": "Enfim, a resposta à velha pergunta: uma lontra que <italic(1)>cospe<italic(0)> água é mais estranha que uma lontra fora d’água? Talvez. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#62", "hash": "FC1D8A18ECEA6DDC", "target": "Área de cultivo" },
    { "gameKey": "MJIText#63", "hash": "A08483F4565D2E4C", "target": "Pasto" },
    { "gameKey": "MJIText#64", "hash": "11DA545A1628A617", "target": "Canteiros de terra fértil e arada, ideais para o cultivo." },
    { "gameKey": "MJIText#65", "hash": "3D940F0B79DFE3F9", "target": "Um campo verdejante que acolhe os animais da ilha de todos os tamanhos e feitios." },
    { "gameKey": "MJIText#66", "hash": "6ABB3F169506C94A", "target": "Índice da ilha" },
    { "gameKey": "MJIText#67", "hash": "5EFEC6D34174DCCE", "target": "Jardim das brincadeiras" },
    { "gameKey": "MJIText#68", "hash": "432D594B8E8178F0", "target": "De “jardim”, este lugar só tem o nome. É um parque de diversões idealizado por um grupo de mammets que planejam criar seu próprio paraíso secreto, um monumento de cada vez. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#69", "hash": "BC6B5F3FAF761D07", "target": "Celeiro IV" },
    { "gameKey": "MJIText#70", "hash": "CFEB8C1E9CBBA836", "target": "Celeiro V" },
    { "gameKey": "MJIText#71", "hash": "56B6F3239C777BA8", "target": "Cavernas em Colapso" },
    { "gameKey": "MJIText#72", "hash": "CEAF047C80BC6549", "target": "Uma instalação de ponta, projetada especialmente para atender mammets coletores experientes." },
    { "gameKey": "MJIText#73", "hash": "E34923BFB8077B50", "target": "Cabana aconchegante IV" },
    { "gameKey": "MJIText#74", "hash": "D44F933ADFA3E422", "target": "Da proa ao sólido segundo andar, cada detalhe desta elegante construção reflete a prosperidade da ilha." },
    { "gameKey": "MJIText#75", "hash": "9C53900D7BEBD707", "target": "Oficina IV" },
    { "gameKey": "MJIText#76", "hash": "A7C8FD86454CA7CD", "target": "Uma instalação projetada para que os mammets artesãos mais experientes trabalhem com ainda mais eficiência." },
    { "gameKey": "MJIText#77", "hash": "827033EE4A4815CB", "target": "Piso de tijolos em arcos" },
    { "gameKey": "MJIText#78", "hash": "D59943700F30A8B6", "target": "Caminho de tijolos em arcos" },
    { "gameKey": "MJIText#79", "hash": "9CB2155A264A5D5D", "target": "Escada de tijolos em arcos" },
    { "gameKey": "MJIText#80", "hash": "7A147D2632E1E40F", "target": "Rota inexplorada" },
    { "gameKey": "MJIText#81", "hash": "DC30DA8AEACEE975", "target": "A fragata que um dia navegaria pelo mar acabou virando um parque de diversões. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#82", "hash": "F9AF7658A98306C6", "target": "Torre do relógio pitoresca" },
    { "gameKey": "MJIText#83", "hash": "3584B61724386BE2", "target": "Um relógio que marca as horas sem pressa, com direito a um pêndulo que balança devagar. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#84", "hash": "A8937C7A9DACC32D", "target": "Ambição do Ilhéu" },
    { "gameKey": "MJIText#85", "hash": "D93C84269768B121", "target": "Mirante do Ilhéu" },
    { "gameKey": "MJIText#86", "hash": "6D996FDB7BBE0FA0", "target": "Um depósito imponente, de uso exclusivo dos mammets mestres em coleta." },
    { "gameKey": "MJIText#87", "hash": "31161AE1AD709271", "target": "Cabana aconchegante V" },
    { "gameKey": "MJIText#88", "hash": "76AA8BBD8A314D5C", "target": "Uma construção luxuosa que exibe tudo o que o trabalho na ilha rendeu." },
    { "gameKey": "MJIText#89", "hash": "2BC1B8F6B4455A9F", "target": "Oficina V" },
    { "gameKey": "MJIText#90", "hash": "73105B9BEAA2CB92", "target": "Uma oficina impressionante, equipada para os mais hábeis mammets artesãos." },
    { "gameKey": "MJIText#91", "hash": "593E20062E6AEB13", "target": "Árvore etérea" },
    { "gameKey": "MJIText#92", "hash": "5FA57A856F3BBC09", "target": "Uma fusão inusitada de árvore e cristal que emana uma poderosa energia etérea. Os mammets da ilha adoram." },
    { "gameKey": "MJIText#93", "hash": "75E49F41459E85C2", "target": "Santuário do santuário" },
    { "gameKey": "MJIText#94", "hash": "77C7B57A249D7099", "target": "Criado por mammets em busca de um santuário próprio dentro de um santuário alheio. Os mammets da ilha adoram." },
