  "entries": [
    { "gameKey": "GeneralAction#1.0", "hash": "F172C0074052DC60", "target": "Ataque automático" },
    { "gameKey": "GeneralAction#1.1", "hash": "491F40B1F8E4ED43", "target": "Ataque automaticamente seu alvo atual em intervalos fixos determinados pela sua arma." },
    { "gameKey": "GeneralAction#2.0", "hash": "33A46B5B60E9E964", "target": "Pular" },
    { "gameKey": "GeneralAction#2.1", "hash": "F20F103FE205C548", "target": "Flexione as pernas e estenda-as de uma vez para saltar do chão ou de outra superfície." },
    { "gameKey": "GeneralAction#3.0", "hash": "0453C0983E4338A9", "target": "Limit Break" },
    { "gameKey": "GeneralAction#3.1", "hash": "615074376A682417", "target": "Consuma a energia acumulada na barra de Limit Break do seu grupo para executar uma técnica de combate poderosa. A técnica depende da <colortype(500)><edgecolortype(501)>função<edgecolortype(0)><colortype(0)> de quem a inicia.<br>Tanque: aumenta a defesa do grupo (raio: 50y).<br>Corpo a corpo: ataca um único alvo.<br>Físico à distância: ataca todos os alvos em linha reta (alcance: 30y).<br>Mágico à distância: ataca em área (raio: 8y/10y/15y).<br>Curandeiro: restaura HP e, no nível 3, ressuscita (raio: 50y).<br>※Se o alvo estiver sob efeito de fraqueza ao ressuscitar, a duração do efeito recomeça. Caso contrário, o alvo ressuscita sem o efeito." },
    { "gameKey": "GeneralAction#4.0", "hash": "756A7B05B883A50C", "target": "Sprint" },
    { "gameKey": "GeneralAction#4.1", "hash": "44383BF4902D4A34", "target": "Aumenta a velocidade de movimento.<br><colortype(504)><edgecolortype(505)>Duração: <edgecolortype(0)><colortype(0)>10 s (20 s fora de combate)<br>※Indisponível no PvP." },
    { "gameKey": "GeneralAction#5.0", "hash": "4DA935E90959B1A1", "target": "Dessíntese" },
    { "gameKey": "GeneralAction#5.1", "hash": "65027456863EA414", "target": "Desmonte um item para recuperar um ou mais dos materiais que o compõem." },
    { "gameKey": "GeneralAction#6.0", "hash": "4E8E82F33E3E09FC", "target": "Reparar" },
    { "gameKey": "GeneralAction#6.1", "hash": "1F8B0531582F13E3", "target": "Use matéria escura para consertar equipamentos danificados." },
    { "gameKey": "GeneralAction#7.0", "hash": "D1226DC8E16704ED", "target": "Teleporte" },
    { "gameKey": "GeneralAction#7.1", "hash": "FE8D5981F73409D9", "target": "Converta seu corpo em éter e teleporte-se instantaneamente para qualquer eterita com a qual já tenha se sintonizado. Você paga uma taxa em gil ao chegar ao destino." },
    { "gameKey": "GeneralAction#8.0", "hash": "E1E9FF3ECC441519", "target": "Retorno" },
    { "gameKey": "GeneralAction#8.1", "hash": "B99238801D80D91A", "target": "Volte instantaneamente ao seu ponto de retorno atual." },
    { "gameKey": "GeneralAction#9.0", "hash": "BA5E06D5B9C6C104", "target": "Roleta de montarias" },
    { "gameKey": "GeneralAction#9.1", "hash": "2D7B6C74111E9514", "target": "Invoque uma montaria aleatória." },
