    { "gameKey": "GeneralAction#12.0", "hash": "51416F771515B028", "target": "Engaste de matéria" },
    { "gameKey": "GeneralAction#12.1", "hash": "1E6CE659A476E0A3", "target": "Engaste matérias em armas e armaduras." },
    { "gameKey": "GeneralAction#13.0", "hash": "329706B15423F553", "target": "Engaste avançado de matéria" },
    { "gameKey": "GeneralAction#13.1", "hash": "0AC4395138BEE39A", "target": "Engaste matérias em armas e armaduras. Você também pode engastá-las em itens sem espaços livres, mas o sucesso não é garantido." },
    { "gameKey": "GeneralAction#14.0", "hash": "B480B44A0087919C", "target": "Extração de matéria" },
    { "gameKey": "GeneralAction#14.1", "hash": "99A614D90E70AFAE", "target": "Extraia o éter de um item com vínculo espiritual completo e recristalize o resíduo para obter uma substância concentrada conhecida como “matéria”." },
