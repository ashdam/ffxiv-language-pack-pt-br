    { "gameKey": "GoldSaucerTextData#71", "hash": "F1BCFE488286AB5C", "target": "Any Way the Wind Blows" },
    { "gameKey": "GoldSaucerTextData#72", "hash": "558CEE55B754815D", "target": "Suba ao palco principal e teste sua astúcia contra Tifão, o mestre das bufadas. Vai conseguir ficar no tablado até o tempo acabar ou o vento vai levar você?" },
    { "gameKey": "GoldSaucerTextData#73", "hash": "BD7F39E18FE67D3D", "target": "Preveja o local da próxima bufada de Tifão e vá para um ponto que considere seguro." },
    { "gameKey": "GoldSaucerTextData#74", "hash": "492431748E8F0043", "target": "Bufadas evitadas" },
    { "gameKey": "GoldSaucerTextData#81", "hash": "FFBE01A11A731A5F", "target": "Skinchange We Can Believe In" },
    { "gameKey": "GoldSaucerTextData#82", "hash": "A9B2C0BFC23C323D", "target": "Um diabrete perverso tomou a forma de um cliente respeitável do Gold Saucer e está escondido em algum lugar por aqui. Encontre o sósia perfeito do solicitante do GATE e jogue nele uma boa dose de cinza brilhante." },
    { "gameKey": "GoldSaucerTextData#91", "hash": "D5E0D1B105C0F219", "target": "Cliffhanger" },
