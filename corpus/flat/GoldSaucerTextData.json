    { "gameKey": "GoldSaucerTextData#110", "hash": "84D84A7AAD4E841E", "target": "Boas-vindas à pista de treinamento!" },
    { "gameKey": "GoldSaucerTextData#111", "hash": "BF96EA78D17D50F6", "target": "Siga todas as instruções da treinadora de corridas." },
    { "gameKey": "GoldSaucerTextData#112", "hash": "083C747FAFA061C5", "target": "Treinamento concluído!" },
    { "gameKey": "GoldSaucerTextData#113", "hash": "44DDF474A61E236B", "target": "???" },
    { "gameKey": "GoldSaucerTextData#114", "hash": "331032DD412E0D00", "target": "Acelere." },
    { "gameKey": "GoldSaucerTextData#115", "hash": "B9B72CBD091A456E", "target": "Acelere até a energia acabar." },
    { "gameKey": "GoldSaucerTextData#116", "hash": "7420BA74E4139502", "target": "Acelere até a velocidade máxima e depois desacelere." },
    { "gameKey": "GoldSaucerTextData#117", "hash": "A1B2E1AD8FF332E9", "target": "Mova-se para os lados." },
    { "gameKey": "GoldSaucerTextData#118", "hash": "D5BAA5E9CB636E76", "target": "Acione um painel mágico." },
    { "gameKey": "GoldSaucerTextData#119", "hash": "2381DFBA4F0A0797", "target": "Pule." },
    { "gameKey": "GoldSaucerTextData#120", "hash": "F13C0DB98DE78C14", "target": "Abra um cofre do tesouro." },
    { "gameKey": "GoldSaucerTextData#121", "hash": "45338633B4148BD3", "target": "Use um item de corrida." },
    { "gameKey": "GoldSaucerTextData#131", "hash": "7A864D6C4FC26089", "target": "As regras do Mini Cactpot são simples. Primeiro, revele três dos oito números escondidos no bilhete. Depois, escolha uma das oito linhas, na vertical, na horizontal ou na diagonal." },
    { "gameKey": "GoldSaucerTextData#132", "hash": "F1E5994A1E7CD945", "target": "Depois de escolher uma linha, todos os números são revelados. A soma dos três números da linha escolhida determina seu prêmio em MGP. É simples assim!" },
    { "gameKey": "GoldSaucerTextData#133", "hash": "AB0CA2D93927EBE4", "target": "Agora só falta escolher um número de quatro algarismos. O número vencedor será sorteado depois. Se o último algarismo do seu número coincidir com o vencedor, você ganha o 4º prêmio. Se os dois últimos coincidirem, ganha o 3º. Se forem os três últimos, ganha o 2º, e, se todos coincidirem, leva o prêmio principal." },
