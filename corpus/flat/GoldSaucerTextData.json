    { "gameKey": "GoldSaucerTextData#61", "hash": "9B419500ED2259E7", "target": "The Time of My Life" },
    { "gameKey": "GoldSaucerTextData#62", "hash": "A02D0C58F2FF6196", "target": "Suba ao palco principal e memorize a coreografia para o grande número de dança." },
    { "gameKey": "GoldSaucerTextData#63", "hash": "5DA7F609BA7D6CB1", "target": "Memorize a coreografia dos mestres e das mestras da dança e execute dez movimentos ou mais sem errar, no momento indicado." },
    { "gameKey": "GoldSaucerTextData#64", "hash": "EAFA31257BA70C03", "target": "Primeira sequência" },
