    {
      "_divider": "A SAGA E O MUNDO. Precedência: o Final Fantasy oficial em pt-BR (XV, VII Remake e Rebirth, XVI), depois o MMO brasileiro (World of Warcraft), depois o corpus entregue, depois o francês. Confiança: alta = precedente oficial ou forma única; média = segue o francês ou o espanhol entregue; baixa = cunhado, sem precedente."
    },
    { "en": "moogle", "fr": "mog", "ja": "モーグリ", "pt-BR": "moogle", "protect": true, "note": "Como a saga imprime em pt-BR. Nunca «moguri», que é a forma espanhola." },
    { "en": "chocobo", "fr": "chocobo", "ja": "チョコボ", "pt-BR": "chocobo", "protect": true },
    { "en": "kupo", "fr": "kupo", "ja": "クポ", "pt-BR": "kupo", "protect": true, "note": "Alongamentos seguem o inglês: «Kupopo»." },
    { "en": "aether", "fr": "éther", "ja": "エーテル", "pt-BR": "éter", "protect": false, "note": "Final Fantasy XVI em pt-BR. Adjetivo «etéreo»." },
    { "en": "Mothercrystal", "fr": "Cristal-mère", "ja": "マザークリスタル", "pt-BR": "Cristal-Máter", "protect": false, "note": "Final Fantasy XVI em pt-BR imprime exatamente isto para a mesma palavra inglesa." },
    { "en": "aetheryte", "fr": "éthérite", "ja": "エーテライト", "pt-BR": "eterita", "protect": false, "note": "Feminino, como o francês. O nome do destino no menu de teleporte fica em inglês; a palavra comum em prosa é esta." },
    { "en": "aethernet", "fr": "réseau éthéré", "ja": "エーテルネット", "pt-BR": "rede etérea", "protect": false },
    { "en": "primal", "fr": "Primordial", "ja": "蛮神", "pt-BR": "primordial", "protect": false, "note": "Substantivo «os primordiais». Nunca «eikon», que é a palavra de Final Fantasy XVI para outra coisa, nem o inglês." },
    { "en": "the Echo", "fr": "l'Écho", "ja": "超える力", "pt-BR": "o Eco", "protect": false },
    { "en": "Ascian", "fr": "Ascien", "ja": "アシエン", "pt-BR": "asciano", "protect": false, "note": "Minúscula, como qualquer gentílico; plural «ascianos»." },
    { "en": "Garlean", "fr": "garlemaldais", "ja": "ガレマール", "pt-BR": "garleano", "protect": false, "note": "«o Império Garleano»; Garlemald fica." },
    { "en": "Eorzean", "fr": "éorzéen", "ja": "エオルゼア", "pt-BR": "eorzeano", "protect": false, "note": "Eorzea fica; «a Aliança Eorzeana»." },
    { "en": "Hydaelyn", "fr": "Hydaelyn", "ja": "ハイデリン", "pt-BR": "Hydaelyn", "protect": true },
    { "en": "Midgardsormr", "fr": "Midgardsormr", "ja": "ミドガルズオルム", "pt-BR": "Midgardsormr", "protect": true },
    { "en": "the Scions of the Seventh Dawn", "fr": "les Héritiers de la Septième Aube", "ja": "暁の血盟", "pt-BR": "os Herdeiros do Sétimo Amanhecer", "protect": false, "note": "Forma curta «os Herdeiros»; um membro é «um Herdeiro». Segue o francês e o espanhol entregue. Nunca o inglês em prosa." },
    { "en": "the Calamity", "fr": "le Fléau", "ja": "災厄", "pt-BR": "a Calamidade", "protect": false, "note": "«a Sétima Calamidade Umbral»; «a Sétima Era Umbral», «a Sétima Era Astral», ordinal por extenso." },
    { "en": "Warrior of Light", "fr": "Guerrier de la Lumière", "ja": "光の戦士", "pt-BR": "<if(gnum4,Guerreira,Guerreiro)> da Luz", "protect": false, "note": "Com a macro quando nomeia o jogador; masculino plano no plural e no uso histórico. Warrior of Darkness igual, «das Trevas»." },
    { "en": "the Twelve", "fr": "les Douze", "ja": "十二神", "pt-BR": "os Doze", "protect": false, "note": "Os nomes dos deuses ficam." },
    { "en": "the Ultima Weapon", "fr": "l'Ultima Arma", "ja": "アルテマウェポン", "pt-BR": "a Arma Ultima", "protect": false, "note": "«Ultima» sem acento, como a saga imprime a magia." },
    { "en": "beast tribe", "fr": "tribu barbare", "ja": "蛮族", "pt-BR": "tribo bestial", "protect": false, "note": "BAIXA. Plural «tribos bestiais»." },
    { "en": "sylph", "fr": "sylphe", "ja": "シルフ", "pt-BR": "silfo", "protect": false, "note": "A criatura em minúscula. O povo, «os Sylph», fica com maiúscula e invariável como os outros povos." },
    { "en": "Amalj'aa", "pt-BR": "Amalj'aa", "protect": true, "note": "Os povos ficam como o inglês, com maiúscula e invariáveis: os Amalj'aa, os Ixal, os Sahagin, os Kobold, os Qiqirn, os Padjal." },
    { "en": "Ixal", "pt-BR": "Ixal", "protect": true },
    { "en": "Sahagin", "pt-BR": "Sahagin", "protect": true },
    { "en": "Kobold", "pt-BR": "Kobold", "protect": true },
    { "en": "Qiqirn", "pt-BR": "Qiqirn", "protect": true },
    { "en": "Padjal", "pt-BR": "Padjal", "protect": true },
    { "en": "Good King Moggle Mog", "fr": "Moggle Mog", "ja": "グッドキング・モグル・モグ", "pt-BR": "o Bom Rei Moggle Mog", "protect": false },
    { "en": "Iceheart", "fr": "Cœur-de-glace", "ja": "アイスハート", "pt-BR": "Coração de Gelo", "protect": false, "note": "Sem artigo; «Lady Iceheart» é «a senhora Coração de Gelo»." },
    {
      "_divider": "INSTITUIÇÕES E TÍTULOS. Traduzidos e com as maiúsculas do inglês."
