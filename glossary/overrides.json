    { "en": "Grand Company", "fr": "grande compagnie", "ja": "グランドカンパニー", "pt-BR": "Grande Companhia", "protect": false, "note": "Plural «Grandes Companhias»." },
    { "en": "the Immortal Flames", "fr": "les Immortels", "ja": "不滅隊", "pt-BR": "as Chamas Imortais", "protect": false, "note": "«o Salão das Chamas» (the Hall of Flames); «o General das Chamas» (the Flame General)." },
    { "en": "the Maelstrom", "fr": "le Maelstrom", "ja": "黒渦団", "pt-BR": "o Maelstrom", "protect": false, "note": "«o Comando do Maelstrom» (Maelstrom Command); «a Almirante» (the Admiral)." },
    { "en": "the Order of the Twin Adder", "fr": "l'ordre des Deux Vipères", "ja": "双蛇党", "pt-BR": "a Ordem das Duas Víboras", "protect": false, "note": "«o Ninho das Víboras» (the Adders' Nest). MÉDIA." },
    { "en": "the Eorzean Alliance", "fr": "l'Alliance éorzéenne", "ja": "エオルゼア同盟", "pt-BR": "a Aliança Eorzeana", "protect": false, "note": "Forma curta «a Aliança»." },
    { "en": "the Elder Seedseer", "fr": "notre oracle", "ja": "幻術皇", "pt-BR": "a Vidente-Mor", "protect": false, "note": "BAIXA, cunhado: «-mor» é a forma brasileira de «chefe de». «os Videntes» (the Seedseers)." },
