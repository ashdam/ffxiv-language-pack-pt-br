    "ELIDIBUS": { "player": "você", "confidence": "medium", "why": "Francês vous, japonês 君/だ, forma plana. A distância vai no léxico.", "voice": "O Emissário: calmo, cerimonioso, nunca hostil.", "examples": [] },
